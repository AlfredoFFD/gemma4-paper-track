+def get_endpoint_context(dependant: Dependant, route: Any) -> str:
+    try:
+        func = dependant.call
+        file = inspect.getfile(func)
+        lines, start_line = inspect.getsourcelines(func)
+        name = func.__name__
+        method = "WS"
+        if hasattr(route, "methods"):
+            method = ", ".join(route.methods)
+        path = route.path
+        return f"Endpoint: {method} {path} ({name} in {file}:{start_line})"
+    except Exception:
+        return ""
