+from rich.text import Text
+from rich.console import Console
+
+def test_wrap_newlines():
+    console = Console(width=10)
+    texts = [
+        "hello\nworld",
+        "hello\n\nworld",
+        "hello\n",
+        "\nhello",
+        "\n\n",
+        "hello\n\n",
+        "\n\nhello",
+    ]
+    for t_str in texts:
+        t = Text(t_str)
+        wrapped = t.wrap(console, 10)
+        print(f"Input: {t_str!r} -> Wrapped: {[line.plain for line in wrapped]!r}")
+
+if __name__ == "__main__":
+    test_wrap_newlines()
