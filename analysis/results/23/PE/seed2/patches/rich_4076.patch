@@ -0,0 +1,13 @@
+from rich.text import Text
+
+def test_split_blank_lines():
+    t = Text("a\n\nb")
+    split_text = t.split(allow_blank=True)
+    print(f"Input: {t.plain!r} -> Split: {[line.plain for line in split_text]!r}")
+    
+    t2 = Text("\n\n")
+    split_text2 = t2.split(allow_blank=True)
+    print(f"Input: {t2.plain!r} -> Split: {[line.plain for line in split_text2]!r}")
+
+if __name__ == "__main__":
+    test_split_blank_lines()
