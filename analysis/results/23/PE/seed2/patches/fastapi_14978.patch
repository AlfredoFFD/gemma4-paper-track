diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..15bbd036
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,59 @@
+from fastapi import FastAPI, Body, Request
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.post("/strict")
+async def strict_endpoint(payload: dict = Body(..., strict_content_type=True)):
+    return {"message": "success", "payload": payload}
+
+@app.post("/non-strict")
+async def non_strict_endpoint(payload: dict = Body(..., strict_content_type=False)):
+    return {"message": "success", "payload": payload}
+
+client = TestClient(app)
+
+def test_strict_content_type():
+    # 1. Valid JSON with correct content type
+    response = client.post("/strict", json={"foo": "bar"})
+    assert response.status_code == 200
+    assert response.json() == {"message": "success", "payload": {"foo": "bar"}}
+
+    # 2. Valid JSON but missing content type (TestClient.post(json=...) sets it, so we use content=...)
+    # We need to send raw bytes to avoid TestClient setting the header
+    import json
+    response = client.post("/strict", content=json.dumps({"foo": "bar"}), headers={})
+    print(f"Test 2 - Status Code: {response.status_code}")
+    print(f"Test 2 - Response Body: {response.json()}")
+    assert response.status_code == 422
+    assert response.json()["detail"][0]["loc"] == ["header", "content-type"]
+    assert response.json()["detail"][0]["msg"] == "Content-Type header is required"
+
+    # 3. Valid JSON but wrong content type
+    response = client.post("/strict", content=json.dumps({"foo": "bar"}), headers={"content-type": "text/plain"})
+    assert response.status_code == 422
+    assert response.json()["detail"][0]["loc"] == ["header", "content-type"]
+    assert response.json()["detail"][0]["msg"] == "Unsupported media type"
+
+    # 4. Non-strict: missing content type should work
+    response = client.post("/non-strict", content=json.dumps({"foo": "bar"}), headers={})
+    assert response.status_code == 200
+    assert response.json() == {"message": "success", "payload": {"foo": "bar"}}
+
+    # 5. Non-strict: wrong content type should work (it will be passed as bytes to the endpoint if not parsed as JSON, 
+    # but since we have a type hint `dict`, Pydantic will try to validate it. 
+    # If it's passed as bytes, Pydantic might fail if it's not a dict.
+    # Wait, if strict_content_type is False, and it's not JSON, `body` becomes `body_bytes`.
+    # Then Pydantic tries to validate `body_bytes` as a `dict`. This should fail with a validation error, 
+    # but not a "Unsupported media type" error from our new logic.)
+    response = client.post("/non-strict", content=json.dumps({"foo": "bar"}), headers={"content-type": "text/plain"})
+    # In this case, json_body is Undefined, so body = body_bytes.
+    # Pydantic will then try to validate bytes as a dict, which fails.
+    assert response.status_code == 422
+    # The error should be a Pydantic validation error, not our "Unsupported media type" error.
+    assert response.json()["detail"][0]["loc"] == ["body"]
+
+if __name__ == "__main__":
+    test_strict_content_type()
+    print("All tests passed!")
diff --git a/reproduction_script.py b/reproduction_script.py
new file mode 100644
index 00000000..c93e0409
--- /dev/null
+++ b/reproduction_script.py
@@ -0,0 +1,39 @@
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+import json
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(item: dict = Body(..., strict_content_type=True)):
+    return {"message": "success"}
+
+client = TestClient(app)
+
+def test_strict_content_type_missing_header():
+    # Missing Content-Type header should return 422
+    response = client.post("/test", content=json.dumps({"item": "value"}), headers={})
+    assert response.status_code == 422, f"Expected 422 for missing header, got {response.status_code}"
+
+def test_strict_content_type_wrong_header():
+    # Wrong Content-Type header should return 422
+    response = client.post("/test", content=json.dumps({"item": "value"}), headers={"Content-Type": "text/plain"})
+    assert response.status_code == 422, f"Expected 422 for wrong header, got {response.status_code}"
+
+def test_strict_content_type_correct_header():
+    # Correct Content-Type header should return 200
+    response = client.post("/test", json={"item": "value"})
+    assert response.status_code == 200, f"Expected 200 for correct header, got {response.status_code}"
+
+if __name__ == "__main__":
+    try:
+        test_strict_content_type_missing_header()
+        print("test_strict_content_type_missing_header passed")
+        test_strict_content_type_wrong_header()
+        print("test_strict_content_type_wrong_header passed")
+        test_strict_content_type_correct_header()
+        print("test_strict_content_type_correct_header passed")
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
