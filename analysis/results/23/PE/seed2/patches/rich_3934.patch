new file mode 100644
index 00000000..6c0caa68
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,17 @@
+from rich.live import Live
+from rich.console import Console
+import time
+
+console = Console()
+try:
+    with Live([], refresh_per_second=4, console=console) as live:
+        print("Live started with empty list")
+        time.sleep(1)
+        live.update([])
+        print("Live updated with empty list")
+        time.sleep(1)
+    print("Live finished successfully")
+except Exception as e:
+    print(f"Caught exception: {e}")
+    import traceback
+    traceback.print_exc()
