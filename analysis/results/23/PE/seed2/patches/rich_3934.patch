@@ -0,0 +1,8 @@
+from rich.live import Live
+from rich.text import Text
+import time
+
+with Live(Text("Line 1\nLine 2"), refresh_per_second=4) as live:
+    for i in range(5):
+        live.update(Text(f"Line 1-{i}\nLine 2-{i}"))
+        time.sleep(0.5)
