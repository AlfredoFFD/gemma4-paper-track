@@ -0,0 +1,26 @@
+
+from rich.text import Text
+
+def test_append_tokens_empty():
+    t = Text("hello")
+    t.append_tokens([])
+    print(f"Text: {t.plain}, Length: {len(t)}")
+
+def test_append_tokens_none():
+    t = Text("hello")
+    try:
+        t.append_tokens(None)
+    except Exception as e:
+        print(f"Caught expected exception: {e}")
+
+def test_append_tokens_not_tuples():
+    t = Text("hello")
+    try:
+        t.append_tokens(["a", "b"])
+    except Exception as e:
+        print(f"Caught expected exception: {e}")
+
+if __name__ == "__main__":
+    test_append_tokens_empty()
+    test_append_tokens_none()
+    test_append_tokens_not_tuples()
