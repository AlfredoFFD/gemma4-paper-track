diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..6e7077ed
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,38 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.routing import APIRoute
+import json
+
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def dep_a():
+    return "a"
+
+def dep_b(token: str = Security(oauth2_scheme, scopes=["scope1"])):
+    return "b"
+
+def dep_c(token: str = Security(oauth2_scheme, scopes=["scope2"])):
+    return "c"
+
+def common_dep(a: str = Depends(dep_a)):
+    return "common"
+
+app = FastAPI()
+
+@app.get("/test1", dependencies=[Depends(dep_b), Depends(common_dep)])
+async def test1():
+    return {"message": "test1"}
+
+@app.get("/test2", dependencies=[Depends(dep_c), Depends(common_dep)])
+async def test2():
+    return {"message": "test2"}
+
+# Let's inspect the routes
+for route in app.routes:
+    print(f"Route: {route.path}, Type: {type(route)}")
+    if isinstance(route, APIRoute):
+        print(f"  Dependants: {route.dependant}")
+
+# Now let's see what OpenAPI says
+openapi_schema = app.openapi()
+print(json.dumps(openapi_schema, indent=2))
