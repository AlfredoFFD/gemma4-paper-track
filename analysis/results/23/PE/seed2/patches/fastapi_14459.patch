+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+import json
+
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def common_dep(token: str = Security(oauth2_scheme)):
+    return token
+
+def dep_a(common: str = Security(common_dep, scopes=["scope1"])):
+    return "a"
+
+def dep_b(common: str = Security(common_dep, scopes=["scope2"])):
+    return "b"
+
+app = FastAPI()
+
+@app.get("/test", dependencies=[Depends(dep_a), Depends(dep_b)])
+async def test():
+    return {"message": "test"}
+
+openapi_schema = app.openapi()
+print(json.dumps(openapi_schema, indent=2))
diff --git a/reproduce_bug.py b/reproduce_bug.py
new file mode 100644
index 00000000..273bfac4
--- /dev/null
+++ b/reproduce_bug.py
@@ -0,0 +1,46 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.dependencies.utils import get_flat_dependant
+from fastapi.openapi.utils import get_openapi_security_definitions
+from pprint import pprint
+
+app = FastAPI()
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+# Dep 3 is the security scheme. It doesn't have its own scopes.
+# It will be used by Dep 1 and Dep 2.
+def dep3():
+    pass
+
+# Dep 1 uses Dep 3 with scope "a"
+def dep1(s=Security(oauth2_scheme, scopes=["a"])):
+    return s
+
+# Dep 2 uses Dep 3 with scope "b"
+def dep2(s=Security(oauth2_scheme, scopes=["b"])):
+    return s
+
+@app.get("/")
+def root(d1=Depends(dep1), d2=Depends(dep2)):
+    return {"hello": "world"}
+
+route = app.routes[0]
+# We use skip_repeats=True to trigger the bug
+flat_dependant = get_flat_dependant(route.dependant, skip_repeats=True)
+security_definitions, operation_security = get_openapi_security_definitions(flat_dependant)
+
+print("Operation Security Requirements:")
+pprint(operation_security)
+
+# Expected: Both scopes "a" and "b" should be present for the oauth2_scheme.
+# Actual (if bug exists): Only one of them (likely "a") will be present.
+
+# Check if both scopes are present
+found_a = any("a" in req.get("oauth2_scheme", []) for req in operation_security)
+found_b = any("b" in req.get("oauth2_scheme", []) for req in operation_security)
+
+if found_a and found_b:
+    print("\nSUCCESS: Both scopes found.")
+else:
+    print(f"\nFAILURE: Scope 'a' found: {found_a}, Scope 'b' found: {found_b}")
+    exit(1)
