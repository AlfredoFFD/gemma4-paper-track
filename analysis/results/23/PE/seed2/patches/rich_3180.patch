@@ -0,0 +1,48 @@
+from rich._wrap import divide_line
+
+def test_divide_line():
+    text = "你好你好你好"
+    width = 3
+    divides = divide_line(text, width, fold=True)
+    print(f"Text: {text}, Width: {width}, Divides: {divides}")
+    
+    # Expected: "你好" (width 4 > 3), so it should fold.
+    # "你" (width 2) fits in 3.
+    # "好" (width 2) doesn't fit in 3-2=1.
+    # So it should be split as "你", "好", "你", "好", "你", "好"
+    # Wait, if width is 3, and each char is 2, then each char must be on its own line.
+    # So divides should be [1, 2, 3, 4, 5]
+    
+    # Let's try width = 4.
+    # "你好" is width 4. It fits.
+    # "你好你好你好"
+    # "你好" (4) fits.
+    # "你好" (4) fits.
+    # "你好" (4) fits.
+    # So divides should be [2, 4]
+    
+    text2 = "你好你好你好"
+    width2 = 4
+    divides2 = divide_line(text2, width2, fold=True)
+    print(f"Text: {text2}, Width: {width2}, Divides: {divides2}")
+
+    # Let's try a case where a word is longer than width and we fold.
+    # "你好你好你好" (width 12), width = 5.
+    # "你好" (4) fits.
+    # "你好" (4) doesn't fit in 5-4=1.
+    # So it should split after "你好".
+    # "你好" (4) fits.
+    # "你好" (4) doesn't fit in 5-4=1.
+    # ...
+    # Divides: [2, 4, 6, 8, 10] ? No, the text is 6 chars long.
+    # "你好" (4)
+    # "你好" (4)
+    # "你好" (4)
+    # Divides: [2, 4]
+    
+    text3 = "你好你好你好"
+    width3 = 5
+    divides3 = divide_line(text3, width3, fold=True)
+    print(f"Text: {text3}, Width: {width3}, Divides: {divides3}")
+
+test_divide_line()
