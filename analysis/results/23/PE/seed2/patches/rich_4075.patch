+from rich.console import Console
+from io import StringIO
+
+def test_empty_print():
+    console = Console(file=StringIO())
+    
+    # Test 1: Default print() should print a newline
+    console.print()
+    output1 = console.file.getvalue()
+    print(f"Test 1: {repr(output1)}")
+    
+    # Reset
+    console.file.truncate(0)
+    console.file.seek(0)
+    
+    # Test 2: print(end="") should print nothing
+    console.print(end="")
+    output2 = console.file.getvalue()
+    print(f"Test 2: {repr(output2)}")
+    
+    # Reset
+    console.file.truncate(0)
+    console.file.seek(0)
+    
+    # Test 3: print(end="foo") should print "foo"
+    console.print(end="foo")
+    output3 = console.file.getvalue()
+    print(f"Test 3: {repr(output3)}")
+
+if __name__ == "__main__":
+    test_empty_print()
