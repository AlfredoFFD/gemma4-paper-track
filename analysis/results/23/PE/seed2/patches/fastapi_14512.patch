@@ -0,0 +1,49 @@
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+import json
+
+class Cat(BaseModel):
+    type: Literal['cat']
+    meow: bool
+
+class Dog(BaseModel):
+    type: Literal['dog']
+    bark: bool
+
+Pet = Annotated[Union[Cat, Dog], Field(discriminator='type')]
+
+app = FastAPI()
+
+@app.post("/pet1")
+async def create_pet1(pet: Pet):
+    return pet
+
+@app.post("/pet2")
+async def create_pet2(pet: Annotated[Pet, Body()]):
+    return pet
+
+client = TestClient(app)
+
+def test_openapi():
+    response = client.get("/openapi.json")
+    assert response.status_code == 200
+    schema = response.json()
+    
+    paths = schema.get('paths', {})
+    
+    # Check /pet1
+    post_pet1 = paths.get('/pet1', {}).get('post', {})
+    json_schema1 = post_pet1.get('requestBody', {}).get('content', {}).get('application/json', {}).get('schema', {})
+    print("Schema for /pet1:")
+    print(json.dumps(json_schema1, indent=2))
+    
+    # Check /pet2
+    post_pet2 = paths.get('/pet2', {}).get('post', {})
+    json_schema2 = post_pet2.get('requestBody', {}).get('content', {}).get('application/json', {}).get('schema', {})
+    print("Schema for /pet2:")
+    print(json.dumps(json_schema2, indent=2))
+
+if __name__ == "__main__":
+    test_openapi()
