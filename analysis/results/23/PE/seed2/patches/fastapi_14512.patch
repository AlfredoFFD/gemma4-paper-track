@@ -0,0 +1,33 @@
+
+from fastapi import FastAPI, Body
+from pydantic import BaseModel, Field
+from typing import Union, Annotated
+import json
+
+class Cat(BaseModel):
+    type: str = "cat"
+    meow: str
+
+class Dog(BaseModel):
+    type: str = "dog"
+    bark: str
+
+Pet = Union[Cat, Dog]
+
+app = FastAPI()
+
+@app.post("/pet")
+async def create_pet(pet: Annotated[Annotated[Pet, Field(discriminator="type")], Body()]):
+    return pet
+
+openapi_schema = app.openapi()
+print(json.dumps(openapi_schema, indent=2))
+
+# Check if discriminator is present in the schema
+# The path is /pet -> post -> requestBody -> content -> application/json -> schema
+schema = openapi_schema["paths"]["/pet"]["post"]["requestBody"]["content"]["application/json"]["schema"]
+if "discriminator" in schema:
+    print("\nSUCCESS: Discriminator found!")
+else:
+    print("\nFAILURE: Discriminator NOT found!")
+    exit(1)
