+from fastapi import FastAPI, Form
+from pydantic import Json
+from typing import Annotated, List
+from fastapi.testclient import TestClient
+from fastapi.dependencies.utils import _get_multidict_value
+from fastapi._compat.v2 import ModelField
+from pydantic.fields import FieldInfo
+from starlette.datastructures import ImmutableMultiDict
+
+app = FastAPI()
+
+@app.post("/upload")
+def upload(
+    tags: Annotated[Json[List[str]], Form()]
+):
+    return {"tags": tags}
+
+# Let's see what the field info is
+# We can find it in the app's route
+route = app.routes[0]
+# The dependants are in route.dependant
+dependant = route.dependant
+# The body params are in dependant.body_params
+# body_params is a list of ModelField
+field = dependant.body_params[0]
+print(f"Field annotation: {field.field_info.annotation}")
+print(f"Field name: {field.name}")
+
+# Now let's test _get_multidict_value
+values = ImmutableMultiDict({"tags": '["abc", "def"]'})
+result = _get_multidict_value(field, values)
+print(f"Result of _get_multidict_value: {result}")
+
+if __name__ == "__main__":
+    # Just run the prints
+    pass
