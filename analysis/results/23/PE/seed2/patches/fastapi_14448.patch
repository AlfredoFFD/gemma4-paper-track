+def _is_async_callable(call: Any, check_fn: Callable[[Any], bool]) -> bool:
+    if call is None:
+        return False
+    if inspect.isclass(call):
+        return False
+    if check_fn(call):
+        return True
+    if isinstance(call, partial):
+        return _is_async_callable(call.func, check_fn)
+    if hasattr(call, "__wrapped__"):
+        return _is_async_callable(call.__wrapped__, check_fn)
+    if not inspect.isroutine(call):
+        dunder_call = getattr(call, "__call__", None)
+        if dunder_call is not None:
+            return _is_async_callable(dunder_call, check_fn)
+    return False
+
