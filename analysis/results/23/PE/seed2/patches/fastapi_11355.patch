@@ -0,0 +1,36 @@
+
+from __future__ import annotations
+from fastapi import FastAPI, Depends
+from pydantic import BaseModel
+import inspect
+from typing import List
+
+class Item(BaseModel):
+    name: str
+
+class CallableDependency:
+    def __call__(self, item: Item) -> Item:
+        return item
+
+def get_item() -> Item:
+    return Item(name="test")
+
+app = FastAPI()
+
+@app.get("/")
+def read_root(dep: CallableDependency = Depends(CallableDependency())):
+    return {"dep": dep}
+
+if __name__ == "__main__":
+    from fastapi.dependencies.utils import get_typed_signature
+    
+    # Test with a function
+    def test_func(item: Item):
+        pass
+    sig_func = get_typed_signature(test_func)
+    print(f"Function param annotation: {sig_func.parameters['item'].annotation}")
+
+    # Test with a callable object
+    dep_obj = CallableDependency()
+    sig_obj = get_typed_signature(dep_obj)
+    print(f"Callable object param annotation: {sig_obj.parameters['item'].annotation}")
