diff --git a/verify_frontend.py b/verify_frontend.py
new file mode 100644
index 000000000..a4cd70ae8
--- /dev/null
+++ b/verify_frontend.py
@@ -0,0 +1,55 @@
+
+from fastapi import FastAPI, APIRouter
+from fastapi.staticfiles import StaticFiles
+import os
+import shutil
+
+def test_fastapi_frontend():
+    print("Testing FastAPI.frontend...")
+    app = FastAPI()
+    static_dir = "test_static_fastapi"
+    os.makedirs(static_dir, exist_ok=True)
+    with open(os.path.join(static_dir, "index.html"), "w") as f:
+        f.write("hello fastapi")
+    
+    app.frontend("/static", static_dir)
+    
+    # Verify that it's mounted
+    # FastAPI.mount calls Starlette.mount, which adds to app.routes
+    mount_found = any(
+        isinstance(route, type(StaticFiles)) or (hasattr(route, 'app') and isinstance(route.app, StaticFiles))
+        for route in app.routes
+    )
+    # Actually, Starlette.mount adds a routing.Mount to routes
+    from starlette.routing import Mount
+    mount_found = any(isinstance(route, Mount) and route.path == "/static" for route in app.routes)
+    
+    print(f"FastAPI.frontend mounted: {mount_found}")
+    assert mount_found
+    shutil.rmtree(static_dir)
+
+def test_apirouter_frontend():
+    print("Testing APIRouter.frontend...")
+    router = APIRouter()
+    static_dir = "test_static_router"
+    os.makedirs(static_dir, exist_ok=True)
+    with open(os.path.join(static_dir, "index.html"), "w") as f:
+        f.write("hello router")
+    
+    router.frontend("/static", static_dir)
+    
+    from starlette.routing import Mount
+    mount_found = any(isinstance(route, Mount) and route.path == "/static" for route in router.routes)
+    
+    print(f"APIRouter.frontend mounted: {mount_found}")
+    assert mount_found
+    shutil.rmtree(static_dir)
+
+if __name__ == "__main__":
+    try:
+        test_fastapi_frontend()
+        test_apirouter_frontend()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)
