diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..f77f5813
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,43 @@
+from typing import Union, List, Sequence, Optional
+from fastapi._compat.shared import field_annotation_is_sequence, field_annotation_is_scalar_sequence, field_annotation_is_scalar
+import types
+
+# Python 3.10+ union syntax
+try:
+    UnionType = types.UnionType
+except AttributeError:
+    UnionType = Union
+
+def test():
+    # Test cases: (annotation, expected_is_sequence, expected_is_scalar_sequence)
+    test_cases = [
+        (List[int], True, True),
+        (list[int], True, True),
+        (Optional[List[int]], True, True),
+        (Union[List[int], None], True, True),
+        (List[int] | None if UnionType is not Union else Optional[List[int]], True, True),
+        (Sequence[int], True, True),
+        (list[str], True, True),
+        (list[dict], True, False),
+        (Union[list[int], list[str]], True, True),
+        (Union[list[int], list[dict]], True, False), # Should be False because list[dict] is not scalar sequence
+        (Union[list[int], None], True, True),
+        (Union[list[dict], None], True, False),
+        # New test cases for Python 3.10 union syntax
+        (list[int] | list[str] if UnionType is not Union else Union[list[int], list[str]], True, True),
+        (list[int] | list[dict] if UnionType is not Union else Union[list[int], list[dict]], True, False),
+        (list[int] | None if UnionType is not Union else Optional[list[int]], True, True),
+        (list[dict] | None if UnionType is not Union else Optional[list[dict]], True, False),
+    ]
+
+    for annotation, exp_seq, exp_scalar_seq in test_cases:
+        res_seq = field_annotation_is_sequence(annotation)
+        res_scalar_seq = field_annotation_is_scalar_sequence(annotation)
+        print(f"Annotation: {annotation}")
+        print(f"  is_sequence: {res_seq} (expected {exp_seq})")
+        print(f"  is_scalar_sequence: {res_scalar_seq} (expected {exp_scalar_seq})")
+        assert res_seq == exp_seq, f"is_sequence failed for {annotation}"
+        assert res_scalar_seq == exp_scalar_seq, f"is_scalar_sequence failed for {annotation}"
+
+if __name__ == "__main__":
+    test()
