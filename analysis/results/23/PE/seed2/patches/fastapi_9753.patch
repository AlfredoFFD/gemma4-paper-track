@@ -0,0 +1,40 @@
+import functools
+from typing import ForwardRef, Any
+from fastapi import FastAPI, Depends
+from fastapi.dependencies.utils import get_typed_signature, get_typed_return_annotation
+
+# Define a type that will be used as a forward reference
+class MyType:
+    pass
+
+def my_dependency(a: "MyType") -> "MyType":
+    return a
+
+# Create a partial of the dependency
+partial_dependency = functools.partial(my_dependency)
+
+def test_get_typed_signature():
+    print("Testing get_typed_signature...")
+    sig = get_typed_signature(partial_dependency)
+    param = list(sig.parameters.values())[0]
+    print(f"Param annotation: {param.annotation}")
+    assert param.annotation is MyType, f"Expected MyType, got {param.annotation}"
+    print("get_typed_signature passed!")
+
+def test_get_typed_return_annotation():
+    print("Testing get_typed_return_annotation...")
+    ret_ann = get_typed_return_annotation(partial_dependency)
+    print(f"Return annotation: {ret_ann}")
+    assert ret_ann is MyType, f"Expected MyType, got {ret_ann}"
+    print("get_typed_return_annotation passed!")
+
+if __name__ == "__main__":
+    try:
+        test_get_typed_signature()
+        test_get_typed_return_annotation()
+        print("\nAll tests passed!")
+    except Exception as e:
+        print(f"\nTest failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
