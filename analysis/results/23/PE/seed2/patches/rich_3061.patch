+from rich.text import Text, Span
+from rich.style import Style
+
+def test_expand_tabs_styles():
+    # Create text with a tab and a style on it
+    text = Text("Hello\tWorld")
+    # Style the tab: "Hello" is index 0-4, "\t" is index 5
+    text.stylize("red", 5, 6) 
+    
+    # Expand tabs
+    text.expand_tabs(tab_size=8)
+    
+    # "Hello" (5 chars) + tab (should be 3 spaces to reach 8) + "World"
+    # Total length should be 5 + 3 + 5 = 13
+    assert len(text) == 13
+    
+    # The spaces replacing the tab should be red.
+    # The tab was at index 5. The spaces are at 5, 6, 7.
+    # Let's check the spans.
+    for span in text._spans:
+        print(f"Span: {span}")
+        # We expect a span that covers the spaces replacing the tab.
+        # The original span was (5, 6, "red").
+        # After expand_tabs, it should be (5, 8, "red").
+        if span.style == "red" or span.style == Style.parse("red"):
+            assert span.start == 5
+            assert span.end == 8
+            print("Success!")
+            return
+
+    print("Failed to find the red span!")
+    assert False
+
+if __name__ == "__main__":
+    try:
+        test_expand_tabs_styles()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)
