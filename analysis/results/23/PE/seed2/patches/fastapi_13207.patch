new file mode 100644
index 00000000..2f9a3556
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,22 @@
+from fastapi import FastAPI
+from pydantic import BaseModel, computed_field
+import json
+
+app = FastAPI(separate_input_output_schemas=True)
+
+class Item(BaseModel):
+    name: str
+    price: float
+
+    @computed_field
+    @property
+    def total_price(self) -> float:
+        return self.price * 1.2
+
+@app.get("/item", response_model=Item)
+def get_item():
+    return Item(name="Test", price=10.0)
+
+if __name__ == "__main__":
+    import pprint
+    pprint.pprint(app.openapi())
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..8bc830bc
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,64 @@
+from fastapi import FastAPI
+from fastapi.openapi.utils import get_openapi
+from pydantic import BaseModel, computed_field
+import json
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    price: float
+
+    @computed_field
+    @property
+    def total_price(self) -> float:
+        return self.price * 1.1
+
+@app.get("/items", response_model=Item)
+def read_item():
+    return Item(name="Test", price=10.0)
+
+def test_openapi_schema(separate_input_output_schemas: bool):
+    openapi_schema = get_openapi(
+        title="Test API",
+        version="1.0.0",
+        routes=app.routes,
+        separate_input_output_schemas=separate_input_output_schemas,
+    )
+    
+    # Find the Item schema in components/schemas
+    schemas = openapi_schema.get("components", {}).get("schemas", {})
+    
+    # If separate_input_output_schemas=True, we expect Item-Output (or Item)
+    # If separate_input_output_schemas=False, we expect Item
+    
+    item_schema = None
+    for name, schema in schemas.items():
+        if "Item" in name:
+            item_schema = schema
+            break
+            
+    if item_schema is None:
+        print(f"Item schema not found for separate_input_output_schemas={separate_input_output_schemas}")
+        return False
+        
+    properties = item_schema.get("properties", {})
+    if "total_price" in properties:
+        print(f"SUCCESS: total_price found in schema for separate_input_output_schemas={separate_input_output_schemas}")
+        return True
+    else:
+        print(f"FAILURE: total_price NOT found in schema for separate_input_output_schemas={separate_input_output_schemas}")
+        return False
+
+if __name__ == "__main__":
+    print("Testing separate_input_output_schemas=True...")
+    res1 = test_openapi_schema(True)
+    
+    print("\nTesting separate_input_output_schemas=False...")
+    res2 = test_openapi_schema(False)
+    
+    if res1 and res2:
+        print("\nALL TESTS PASSED")
+    else:
+        print("\nSOME TESTS FAILED")
+        exit(1)
