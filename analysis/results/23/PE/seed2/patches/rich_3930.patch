+def split_graphemes(text: str) -> list[str]:
+    """Split text into grapheme clusters."""
+    if not text:
+        return []
+
+    graphemes: list[str] = []
+    current_grapheme = ""
+
+    i = 0
+    while i < len(text):
+        char = text[i]
+        if not current_grapheme:
+            current_grapheme = char
+        elif get_character_cell_size(char) == 0:
+            current_grapheme += char
+        elif current_grapheme[-1] == "\u200d":
+            current_grapheme += char
+        else:
+            graphemes.append(current_grapheme)
+            current_grapheme = char
+        i += 1
+
+    if current_grapheme:
+        graphemes.append(current_grapheme)
+
+    return graphemes
