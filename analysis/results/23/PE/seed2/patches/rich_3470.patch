@@ -0,0 +1,18 @@
+from rich.console import Console
+
+def test_record_and_capture():
+    console = Console(record=True)
+    with console.capture() as capture:
+        console.print("Hello World")
+    
+    captured_text = capture.get()
+    print(f"Captured: {captured_text!r}")
+    
+    recorded_text = console.export_text()
+    print(f"Recorded: {recorded_text!r}")
+    
+    assert "Hello World" in captured_text
+    assert "Hello World" in recorded_text
+
+if __name__ == "__main__":
+    test_record_and_capture()
