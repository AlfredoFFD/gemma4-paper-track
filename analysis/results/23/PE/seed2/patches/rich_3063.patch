+from rich.markup import escape, render
+from rich.text import Text
+
+def test_trailing_backslash():
+    text = "Hello \\"
+    escaped = escape(text)
+    print(f"Escaped: {escaped!r}")
+    
+    # This is the case that was failing
+    combined = f"{escaped}[red]!"
+    print(f"Combined: {combined!r}")
+    
+    rendered = render(combined)
+    print(f"Rendered: {rendered}")
+    
+    # We expect the backslash to be literal and the [red] to be a tag
+    # So the result should be "Hello \ [red]!" (where [red] is a style)
+    # In terms of Text object:
+    # text[0:7] = "Hello \"
+    # text[7:8] = "!" with style "red"
+    
+    assert len(rendered) == 8
+    assert rendered[0:7] == "Hello \\"
+    assert rendered[7].style == "red"
+    print("Test passed!")
+
+if __name__ == "__main__":
+    test_trailing_backslash()
