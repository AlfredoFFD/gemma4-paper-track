--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,57 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+import json
+from fastapi.testclient import TestClient
+
+class ModelA(BaseModel):
+    a: str
+
+class ModelB(BaseModel):
+    b: str
+
+app = FastAPI(
+    responses={
+        500: {
+            'model': ModelA | ModelB,
+            'content': {"application/json": {
+                'examples': {"Case A": {"value": "a"}}
+            }}
+        }
+    }
+)
+
+@app.get('/route1')
+def route1():
+    return "test"
+
+@app.get('/route2')
+def route2():
+    return "test"
+
+@app.get('/route3')
+def route3():
+    return "test"
+
+client = TestClient(app)
+
+def test_openapi_duplication():
+    response = client.get("/openapi.json")
+    openapi_json = response.json()
+    
+    # Check route1's 500 response
+    route1_500_schema = openapi_json["paths"]["/route1"]["get"]["responses"]["500"]["content"]["application/json"]["schema"]
+    any_of = route1_500_schema.get("anyOf", [])
+    
+    print(f"Number of anyOf elements: {len(any_of)}")
+    
+    # Expected: 2 elements (ModelA and ModelB)
+    # Actual (buggy): 6 elements (ModelA, ModelB repeated 3 times)
+    assert len(any_of) == 2, f"Expected 2 elements in anyOf, but got {len(any_of)}"
+
+if __name__ == "__main__":
+    try:
+        test_openapi_duplication()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
