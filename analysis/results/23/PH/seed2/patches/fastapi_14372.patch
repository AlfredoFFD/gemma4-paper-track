+from fastapi.params import Depends, Security
+
+d1 = Depends(dependency=lambda: 1)
+d2 = Depends(dependency=lambda: 1)
+s1 = Security(dependency=lambda: 1, scopes=["read"])
+s2 = Security(dependency=lambda: 1, scopes=["read"])
+
+try:
+    hash(d1)
+    print("Depends is hashable")
+except TypeError as e:
+    print(f"Depends is not hashable: {e}")
+
+try:
+    hash(s1)
+    print("Security is hashable")
+except TypeError as e:
+    print(f"Security is not hashable: {e}")
+
+# Also check if they can be used as dictionary keys
+try:
+    {d1: "value"}
+    print("Depends can be a dict key")
+except TypeError as e:
+    print(f"Depends cannot be a dict key: {e}")
+
+try:
+    {s1: "value"}
+    print("Security can be a dict key")
