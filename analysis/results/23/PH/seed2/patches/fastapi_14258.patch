diff --git a/reproduce_fastapi_itself.py b/reproduce_fastapi_itself.py
new file mode 100644
index 00000000..6c8bfa8c
--- /dev/null
+++ b/reproduce_fastapi_itself.py
@@ -0,0 +1,25 @@
+
+from fastapi import FastAPI, APIRouter
+from fastapi.exceptions import FastAPIError
+
+def test_fastapi_include_itself():
+    app = FastAPI()
+    try:
+        app.include_router(app)
+    except FastAPIError as e:
+        print(f"Caught expected error: {e}")
+        return
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+        raise e
+    
+    print("Failed: No error raised when including FastAPI app into itself")
+    raise AssertionError("No error raised when including FastAPI app into itself")
+
+if __name__ == "__main__":
+    try:
+        test_fastapi_include_itself()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)
