         return await run_in_threadpool(dependant.call, **values)
 
 
+def _get_endpoint_metadata(route: Any) -> str:
+    if hasattr(route, "_endpoint_metadata"):
+        return route._endpoint_metadata
+
+    endpoint = route.endpoint
+    try:
+        source_file = inspect.getsourcefile(endpoint)
+        if source_file:
+            lineno = inspect.getlineno(endpoint)
+            filepath = source_file
+        else:
+            filepath = "unknown"
+            lineno = "unknown"
+        func_name = getattr(endpoint, "__name__", "unknown")
+    except Exception:
+        filepath = "unknown"
+        lineno = "unknown"
+        func_name = "unknown"
+
+    methods = ", ".join(route.methods) if hasattr(route, "methods") and route.methods else "WebSocket" if "WebSocket" in str(type(route)) else "unknown"
+    path = getattr(route, "path", "unknown")
+
+    metadata = f"[{filepath}:{lineno} in {func_name}] {methods} {path}"
+    route._endpoint_metadata = metadata
+    return metadata
+
+
