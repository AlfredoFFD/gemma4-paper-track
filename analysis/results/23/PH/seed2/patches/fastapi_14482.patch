@@ -0,0 +1,25 @@
+from fastapi.encoders import jsonable_encoder
+from pydantic import BaseModel, ConfigDict
+
+class ArbitraryType:
+    def __init__(self, value: str):
+        self.value = value
+    def __repr__(self):
+        return f"ArbitraryType({self.value})"
+
+class ModelWithArbitraryType(BaseModel):
+    model_config = ConfigDict(arbitrary_types_allowed=True)
+    item: ArbitraryType
+
+def test_arbitrary_type():
+    item = ArbitraryType(value="hello")
+    model = ModelWithArbitraryType(item=item)
+    print(f"Model: {model}")
+    try:
+        encoded = jsonable_encoder(model)
+        print(f"Encoded: {encoded}")
+    except Exception as e:
+        print(f"Error: {e}")
+
+if __name__ == "__main__":
+    test_arbitrary_type()
