@@ -968,6 +968,26 @@ class Console:
         except ValueError:
             # in some situation (at the end of a pytest run for example) isatty() can raise
             # ValueError: I/O operation on closed file
+            return False
+
+    @property
+    def is_interactive(self) -> bool:
+        """Check if the console is interactive.
+
+        Returns:
+            bool: True if the console is interactive, otherwise False.
+        """
+        environ = self._environ
+
+        tty_interactive = environ.get("TTY_INTERACTIVE", "")
+        # 0 indicates device is not interactive
+        if tty_interactive == "0":
+            return False
+        # 1 indicates device is interactive
+        if tty_interactive == "1":
+            return True
+
+        return self.is_terminal
             # return False because we aren't in a terminal anymore
             return False
 
