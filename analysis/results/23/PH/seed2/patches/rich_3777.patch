index 00000000..2bc7ed14
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,25 @@
+
+import os
+from rich.console import Console
+from rich.live import Live
+from rich.panel import Panel
+import time
+
+def test_interactive():
+    console = Console()
+    print(f"is_terminal: {console.is_terminal}, is_interactive: {console.is_interactive}")
+    with Live(Panel("Starting..."), console=console) as live:
+        time.sleep(0.1)
+        live.update(Panel("Running..."))
+        time.sleep(0.1)
+        live.update(Panel("Finished!"))
+    print("Done.")
+
+if __name__ == "__main__":
+    print("--- Testing with TTY_INTERACTIVE=1 ---")
+    os.environ["TTY_INTERACTIVE"] = "1"
+    test_interactive()
+
+    print("\n--- Testing with TTY_INTERACTIVE=0 ---")
+    os.environ["TTY_INTERACTIVE"] = "0"
+    test_interactive()
