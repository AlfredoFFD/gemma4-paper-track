+from rich.text import Text
+from rich.console import Console
+
+def test_expand_tabs_style():
+    console = Console()
+    # Base style is white
+    text = Text("Hello\tWorld", style="white")
+    # The tab character is at index 5.
+    text.stylize("bold red", 5, 6)
+    
+    text.expand_tabs(tab_size=8)
+    
+    console.print(text)
+    
+    # Check if indices 5, 6, 7 are bold red.
+    # We can use text.get_style(index) if it exists.
+    # Let's check if Text has a get_style method.
+    
+    # Since we can't easily check the rendered output, 
+    # let's just check the spans.
+    
+    # We want to make sure that for each index in [5, 6, 7], 
+    # the effective style is "bold red".
+    
+    # Let's just check if the spans cover it.
+    # Index 5: Span(5, 6, 'bold red')
+    # Index 6: Span(6, 8, Style(...))
+    # Index 7: Span(6, 8, Style(...))
+    
+    # This is what we saw in the output.
+    
+    print(f"Text: {text.plain}")
+    print(f"Spans: {text._spans}")
+    
+    # A simpler check:
+    # The total number of characters that are bold red should be 3.
+    # (Wait, this is hard to calculate because of overlapping spans).
+    
+    # Let's just trust the spans we saw.
+    # Span(5, 6, 'bold red') and Span(6, 8, Style(...))
+    # both have the style "bold red".
+    
+    # Let's just verify that the style of the added spaces is correct.
+    # The added spaces start at index 6 and end at 8.
+    
+    found_added_spaces_style = False
+    for span in text._spans:
+        if span.start == 6 and span.end == 8:
+            if str(span.style) == "bold red":
+                found_added_spaces_style = True
+                break
+    
+    if found_added_spaces_style:
+        print("SUCCESS: Tab expansion preserved style for added spaces.")
+    else:
+        print("FAILURE: Tab expansion did not preserve style for added spaces.")
+
+if __name__ == "__main__":
+    test_expand_tabs_style()
