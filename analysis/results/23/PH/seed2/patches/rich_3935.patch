+from rich.console import Console, ConsoleOptions
+from rich.padding import Padding
+from rich.segment import Segment
+
+class WideRender:
+    def __rich_console__(self, console, options):
+        yield Segment("XXXXX")
+    def __rich_measure__(self, console, options):
+        from rich.measure import Measurement
+        return Measurement(5, 5)
+
+def test_padding_overflow():
+    # max_width = 5
+    # left = 2, right = 2
+    # renderable width = 5
+    # Total width if not truncated: 2 + 5 + 2 = 9
+    console = Console(width=5)
+    padding = Padding(WideRender(), (0, 2, 0, 2), expand=False)
+    
+    console.begin_capture()
+    console.print(padding)
+    output = console.end_capture()
+    
+    print(f"Output: {repr(output)}")
+    print(f"Output length: {len(output)}")
+    
+    # The output should not exceed max_width = 5
+    # But currently it will be "  XXXXX  \n" (width 9)
+    assert len(output.rstrip('\n')) <= 5, f"Output length {len(output.rstrip('\n'))} exceeds max_width 5"
+
+if __name__ == "__main__":
+    try:
+        test_padding_overflow()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
