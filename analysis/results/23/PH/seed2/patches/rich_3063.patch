@@ -0,0 +1,23 @@
+from rich.markup import escape
+from rich.console import Console
+from rich.text import Text
+
+def test_trailing_backslash():
+    text = "Hello \\"
+    escaped = escape(text)
+    print(f"Original: {text!r}")
+    print(f"Escaped: {escaped!r}")
+    
+    console = Console(force_terminal=True)
+    # We want to see if it's rendered correctly.
+    # If it's escaped, it should be rendered as "Hello \"
+    # But if it's not escaped correctly, it might cause issues.
+    
+    # Let's see what happens when we render it.
+    # The issue is likely that a trailing backslash might be treated as an escape for something that doesn't exist.
+    
+    # Let's try to render it.
+    console.print(escaped)
+
+if __name__ == "__main__":
+    test_trailing_backslash()
diff --git a/repro_escape.py b/repro_escape.py
new file mode 100644
index 00000000..916c76c9
--- /dev/null
+++ b/repro_escape.py
@@ -0,0 +1,15 @@
+from rich.markup import escape
+from rich.text import Text
+
+def test_trailing_backslash_escape():
+    text = "Hello \\"
+    escaped = escape(text)
+    combined = escaped + "[bold]World[/bold]"
+    
+    text_obj = Text.from_markup(combined)
+    print(f"Text object: {text_obj}")
+    print(f"Plain text: {text_obj.plain}")
+    print(f"Styles: {text_obj.styles}")
+
+if __name__ == "__main__":
+    test_trailing_backslash_escape()
