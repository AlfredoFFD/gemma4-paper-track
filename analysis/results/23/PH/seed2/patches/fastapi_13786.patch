diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 00000000..103e19ce
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,71 @@
+from fastapi import FastAPI, Depends
+from fastapi.security import APIKeyQuery, APIKeyHeader, APIKeyCookie, HTTPBearer, HTTPDigest, OpenIdConnect
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+api_key_query = APIKeyQuery(name="api_key")
+api_key_header = APIKeyHeader(name="X-API-Key")
+api_key_cookie = APIKeyCookie(name="api_key")
+http_bearer = HTTPBearer()
+http_digest = HTTPDigest()
+openid_connect = OpenIdConnect(openIdConnectUrl="https://example.com/.well-known/openid-configuration")
+
+@app.get("/query")
+async def read_query(api_key: str = Depends(api_key_query)):
+    return {"api_key": api_key}
+
+@app.get("/header")
+async def read_header(api_key: str = Depends(api_key_header)):
+    return {"api_key": api_key}
+
+@app.get("/cookie")
+async def read_cookie(api_key: str = Depends(api_key_cookie)):
+    return {"api_key": api_key}
+
+@app.get("/bearer")
+async def read_bearer(token: str = Depends(http_bearer)):
+    return {"token": token}
+
+@app.get("/digest")
+async def read_digest(token: str = Depends(http_digest)):
+    return {"token": token}
+
+@app.get("/oidc")
+async def read_oidc(token: str = Depends(openid_connect)):
+    return {"token": token}
+
+client = TestClient(app)
+
+def test_security_schemes():
+    schemes = [
+        ("/query", "APIKeyQuery"),
+        ("/header", "APIKeyHeader"),
+        ("/cookie", "APIKeyCookie"),
+        ("/bearer", "HTTPBearer"),
+        ("/digest", "HTTPDigest"),
+        ("/oidc", "OpenIdConnect"),
+    ]
+    
+    for path, name in schemes:
+        response = client.get(path)
+        print(f"Testing {name} at {path}: Status code {response.status_code}")
+        assert response.status_code == 401, f"{name} should return 401, got {response.status_code}"
+        
+        if name == "HTTPBearer" or name == "HTTPDigest" or name == "OpenIdConnect":
+            assert "WWW-Authenticate" in response.headers, f"{name} should have WWW-Authenticate header"
+            print(f"  WWW-Authenticate: {response.headers['WWW-Authenticate']}")
+        
+        if "APIKey" in name:
+            assert "WWW-Authenticate" in response.headers, f"{name} should have WWW-Authenticate header"
+            print(f"  WWW-Authenticate: {response.headers['WWW-Authenticate']}")
+
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    try:
+        test_security_schemes()
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
