diff --git a/repro_type_alias.py b/repro_type_alias.py
new file mode 100644
index 00000000..c3b86a21
--- /dev/null
+++ b/repro_type_alias.py
@@ -0,0 +1,36 @@
+from fastapi._compat import shared
+from typing import Annotated, Union
+import types
+
+# Define a type alias using PEP 695 syntax
+# This requires Python 3.12+
+try:
+    type Point = tuple[float, float]
+    type Scalar = int | float
+    type ComplexAlias = list[int]
+except SyntaxError:
+    # Fallback for older python versions if needed, 
+    # but we are on 3.12.1
+    print("PEP 695 syntax not supported")
+    exit(1)
+
+print(f"Point: {Point}, type: {type(Point)}")
+print(f"Scalar: {Scalar}, type: {type(Scalar)}")
+print(f"ComplexAlias: {ComplexAlias}, type: {type(ComplexAlias)}")
+
+print(f"is_typealiastype(Point): {shared.is_typealiastype(Point)}")
+print(f"is_typealiastype(Scalar): {shared.is_typealiastype(Scalar)}")
+print(f"is_typealiastype(ComplexAlias): {shared.is_typealiastype(ComplexAlias)}")
+
+print(f"field_annotation_is_complex(Point): {shared.field_annotation_is_complex(Point)}") # Should be True (tuple)
+print(f"field_annotation_is_complex(Scalar): {shared.field_annotation_is_complex(Scalar)}") # Should be False (int | float)
+print(f"field_annotation_is_complex(ComplexAlias): {shared.field_annotation_is_complex(ComplexAlias)}") # Should be True (list)
+
+print(f"field_annotation_is_sequence(Point): {shared.field_annotation_is_sequence(Point)}") # Should be True (tuple)
+print(f"field_annotation_is_sequence(Scalar): {shared.field_annotation_is_sequence(Scalar)}") # Should be False
+print(f"field_annotation_is_sequence(ComplexAlias): {shared.field_annotation_is_sequence(ComplexAlias)}") # Should be True (list)
+
+# Test nested alias
+type Nested = Point
+print(f"is_typealiastype(Nested): {shared.is_typealiastype(Nested)}")
+print(f"field_annotation_is_complex(Nested): {shared.field_annotation_is_complex(Nested)}") # Should be True
