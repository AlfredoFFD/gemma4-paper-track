@@ -0,0 +1,23 @@
+from __future__ import annotations
+import inspect
+from typing import List, Dict, Any, get_type_hints
+from fastapi.dependencies.utils import get_typed_signature, get_typed_return_annotation
+
+def test_func(a: List[int], b: Dict[str, int]) -> List[str]:
+    return ["test"]
+
+sig = get_typed_signature(test_func)
+print(f"Annotation a: {sig.parameters['a'].annotation}")
+print(f"Annotation b: {sig.parameters['b'].annotation}")
+print(f"Return annotation: {get_typed_return_annotation(test_func)}")
+
+# Verify it still works with custom types
+class MyType:
+    pass
+
+def test_func_custom(a: MyType) -> MyType:
+    return a
+
+sig_custom = get_typed_signature(test_func_custom)
+print(f"Custom annotation a: {sig_custom.parameters['a'].annotation}")
+print(f"Custom return annotation: {get_typed_return_annotation(test_func_custom)}")
