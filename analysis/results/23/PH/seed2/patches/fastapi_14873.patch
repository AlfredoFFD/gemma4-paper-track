+
+import asyncio
+from fastapi import FastAPI
+
+async def s_start():
+    print("Startup event called!")
+    s_start.called = True
+
+s_start.called = False
+
+app = FastAPI(on_startup=[s_start])
+
+async def main():
+    # Simulate the lifespan process
+    async with app.lifespan(None):
+        pass
+    
+    if not s_start.called:
+        print("FAILED: Startup event was not called")
+        exit(1)
+    else:
+        print("SUCCESS: Startup event was called")
+
+if __name__ == "__main__":
+    asyncio.run(main())
