@@ -0,0 +1,21 @@
+from rich.segment import Segment
+
+def test_bug():
+    text = "あabc"
+    cut = 1
+    seg = Segment(text)
+    left, right = seg.split_cells(cut)
+    print(f"text={repr(text)}, cut={cut}, left={repr(left.text)}, right={repr(right.text)}")
+    # Expected: left width 1, right width 4.
+    # Since 'あ' is width 2, it should be split into ' ' and ' '
+    # So left=' ', right=' abc'
+    expected = (" ", " abc")
+    assert (left.text, right.text) == expected
+
+if __name__ == "__main__":
+    try:
+        test_bug()
+        print("Test passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        raise e
