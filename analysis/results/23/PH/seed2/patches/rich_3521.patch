@@ -0,0 +1,18 @@
+from rich.segment import Segment
+
+def test_zero_width():
+    text = "\u200b\u200ba"
+    cut = 0
+    seg = Segment(text)
+    left, right = seg.split_cells(cut)
+    print(f"text={repr(text)}, cut={cut}, left={repr(left.text)}, right={repr(right.text)}")
+    # We expect ("", "\u200b\u200ba") because zero-width characters should stay with the following character
+    assert (left.text, right.text) == ("", "\u200b\u200ba")
+
+if __name__ == "__main__":
+    try:
+        test_zero_width()
+        print("Test passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        raise e
