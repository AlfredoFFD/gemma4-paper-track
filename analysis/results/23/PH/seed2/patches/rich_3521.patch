diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..c4601bb0
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,34 @@
+from rich.segment import Segment
+from rich.style import Style
+
+def test_split():
+    test_cases = [
+        ("abc", 1, ("a", "bc")),
+        ("abc", 2, ("ab", "c")),
+        ("あabc", 1, (" ", " abc")),
+        ("あabc", 2, ("あ", "abc")),
+        ("abcあ", 3, ("abc", "あ")),
+        ("abcあ", 4, ("abc ", " ")),
+        ("ああ", 1, (" ", " あ")),
+        ("ああ", 2, ("あ", "あ")),
+        ("ああ", 3, ("あ ", " あ")),
+        ("ああ", 4, ("ああ", "")),
+        ("\u200ba", 0, ("", "\u200ba")),
+        ("\u200ba", 1, ("\u200ba", "")),
+        ("a\u200b", 0, ("", "a\u200b")),
+        ("a\u200b", 1, ("a", "\u200b")),
+    ]
+
+    for text, cut, expected in test_cases:
+        seg = Segment(text)
+        left, right = seg.split_cells(cut)
+        print(f"text={repr(text)}, cut={cut}, left={repr(left.text)}, right={repr(right.text)}, expected={expected}")
+        assert (left.text, right.text) == expected
+
+if __name__ == "__main__":
+    try:
+        test_split()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Assertion failed!")
+        raise e
