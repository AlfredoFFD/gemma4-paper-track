--- /dev/null
+++ b/repro_multi.py
@@ -0,0 +1,18 @@
+from rich.console import Console
+import io
+
+def test_soft_wrap_multiple_segments():
+    console = Console(width=20, force_terminal=True, color_system="truecolor")
+    output = io.StringIO()
+    console.file = output
+    
+    text = "[red on blue]First segment[/][green on yellow]Second segment[/]"
+    # Make them long enough to wrap
+    text = "[red on blue]" + "A" * 30 + "[/][green on yellow]" + "B" * 30 + "[/]"
+    console.print(text, soft_wrap=True)
+    
+    result = output.getvalue()
+    print(f"Result: {repr(result)}")
+
+if __name__ == "__main__":
+    test_soft_wrap_multiple_segments()
