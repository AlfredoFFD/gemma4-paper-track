+from rich.console import Console
+import io
+
+def test_wrap_background():
+    console = Console(width=20, force_terminal=True, color_system="truecolor")
+    output = io.StringIO()
+    console.file = output
+    
+    text = "[red on blue]" + "A" * 60 + "[/]"
+    console.print(text, soft_wrap=False)
+    
+    result = output.getvalue()
+    print(f"Result: {repr(result)}")
+
+if __name__ == "__main__":
+    test_wrap_background()
