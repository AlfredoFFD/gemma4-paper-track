@@ -0,0 +1,19 @@
+from fastapi import FastAPI, File, UploadFile
+from typing import Annotated
+import json
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(p: Annotated[bytes, File()]):
+    return {"file_size": len(p)}
+
+def test_schema():
+    openapi = app.openapi()
+    # Find the schema for the request body of /test
+    # In FastAPI, for File(), it usually creates a schema in components/schemas
+    # Let's just print the whole openapi for now to find it
+    print(json.dumps(openapi, indent=2))
+
+if __name__ == "__main__":
+    test_schema()
