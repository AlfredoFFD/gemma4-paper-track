@@ -0,0 +1,28 @@
+from typing import Annotated, List
+from pydantic import BaseModel, Json
+from fastapi import Form
+from fastapi._compat import ModelField, copy_field_info
+from pydantic.fields import FieldInfo
+
+# Mocking ModelField and FieldInfo as they are used in fastapi._compat
+# In a real FastAPI app, these would be created by Pydantic
+class MockModelField:
+    def __init__(self, field_info):
+        self.field_info = field_info
+        self.required = True
+
+# Pydantic v2 FieldInfo for Json[List[str]]
+# We can create a model and get the field info
+class MyModel(BaseModel):
+    tags: Json[List[str]]
+
+field = MyModel.model_fields['tags']
+print(f"Field info: {field}")
+print(f"Metadata: {getattr(field, 'metadata', 'No metadata')}")
+print(f"Annotation: {field.annotation}")
+
+# Now let's see how fastapi._compat.is_sequence_field would handle it
+from fastapi._compat import is_sequence_field
+# We need to wrap it in a MockModelField because is_sequence_field expects ModelField
+mock_field = MockModelField(field)
+print(f"is_sequence_field: {is_sequence_field(mock_field)}")
