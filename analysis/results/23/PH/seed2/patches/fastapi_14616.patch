@@ -0,0 +1,31 @@
+from fastapi import FastAPI, Form
+from pydantic import BaseModel, Json
+from pydantic.types import Json as PydanticJson
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(data: Json[list[str]] = Form(...)):
+    return {"data": data}
+
+client = TestClient(app)
+
+def test_json_form_list():
+    # This should work: a JSON string representing a list
+    response = client.post("/test", data={"data": '["abc", "def"]'})
+    print(f"Response status code: {response.status_code}")
+    print(f"Response body: {response.text}")
+    assert response.status_code == 200
+    assert response.json() == {"data": ["abc", "def"]}
+
+if __name__ == "__main__":
+    try:
+        test_json_form_list()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
