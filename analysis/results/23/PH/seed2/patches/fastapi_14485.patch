@@ -0,0 +1,26 @@
+from __future__ import annotations
+import sys
+from typing import TYPE_CHECKING, Callable, Any
+import inspect
+from fastapi.dependencies.utils import get_typed_return_annotation
+
+if TYPE_CHECKING:
+    class User:
+        pass
+
+def get_user() -> User:
+    return None
+
+def test_reproduce():
+    try:
+        print("Calling inspect.signature...")
+        # We can't easily change get_typed_return_annotation, 
+        # so let's just try to call it.
+        annotation = get_typed_return_annotation(get_user)
+        print(f"Annotation: {annotation}")
+    except Exception as e:
+        print(f"Error: {e}")
+
+
+if __name__ == "__main__":
+    test_reproduce()
