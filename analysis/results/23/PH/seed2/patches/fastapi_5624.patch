+
+from fastapi import FastAPI, Depends, Security
+from fastapi.dependencies.utils import get_dependant
+
+def dep_a(security = Security(None, scopes=["scope_a"])):
+    return security
+
+def dep_b(security = Security(None, scopes=["scope_b"])):
+    return security
+
+def dep_c(a=Depends(dep_a), b=Depends(dep_b)):
+    return "c"
+
+# Simulate the dependency resolution.
+dependant_c = get_dependant(
+    path="dep_c",
+    call=dep_c,
+    security_scopes=[] 
+)
+
+for dep in dependant_c.dependencies:
+    print(f"Dependency {dep.call.__name__} has scopes: {dep.security_scopes}")
