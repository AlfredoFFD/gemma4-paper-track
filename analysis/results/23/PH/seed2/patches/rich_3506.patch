diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..6ccb23f3
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,16 @@
+from rich.segment import Segment
+from rich.cells import cell_len
+
+def test_split_cells():
+    # 'あ' is width 2.
+    text = "Aあ"
+    segment = Segment(text)
+    print(f"Text: {text}, Cell length: {segment.cell_length}")
+    
+    # Split at 2
+    before, after = Segment._split_cells(segment, 2)
+    print(f"Split at 2: before='{before.text}', after='{after.text}'")
+    print(f"Before length: {cell_len(before.text)}, After length: {cell_len(after.text)}")
+
+if __name__ == "__main__":
+    test_split_cells()
diff --git a/repro_control.py b/repro_control.py
new file mode 100644
index 00000000..92241371
--- /dev/null
+++ b/repro_control.py
@@ -0,0 +1,25 @@
+from rich.segment import Segment
+from rich.control import ControlType
+
+def test_split(text, control, cut):
+    seg = Segment(text, None, control)
+    before, after = seg._split_cells(seg, cut)
+    print(f"Text: {text}, Control: {control}, Cut: {cut}")
+    print(f"Before: text={before.text}, control={before.control}")
+    print(f"After: text={after.text}, control={after.control}")
+    print("-" * 20)
+
+# Case 1: Normal split
+test_split("Hello", (ControlType.BELL,), 2)
+# Case 2: Split at 0
+test_split("Hello", (ControlType.BELL,), 0)
+# Case 3: Split at length
+test_split("Hello", (ControlType.BELL,), 5)
+# Case 4: Split beyond length
+test_split("Hello", (ControlType.BELL,), 10)
+# Case 5: No control
+test_split("Hello", None, 2)
+# Case 6: Only control
+test_split("", (ControlType.BELL,), 0)
+# Case 7: Only control, cut > 0
+test_split("", (ControlType.BELL,), 1)
