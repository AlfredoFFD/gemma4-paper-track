diff --git a/verify_fix.py b/verify_fix.py
new file mode 100644
index 00000000..392babb3
--- /dev/null
+++ b/verify_fix.py
@@ -0,0 +1,36 @@
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+def test_openapi_root_path():
+    app = FastAPI(root_path_in_servers=True)
+    client = TestClient(app)
+    response = client.get("/openapi.json")
+    assert response.status_code == 200
+    servers = response.json().get("servers", [])
+    # By default root_path is empty, so it shouldn't be there.
+    for server in servers:
+        assert server["url"] != ""
+
+def test_swagger_ui_escaping():
+    app_malicious = FastAPI(
+        title="<script>alert('xss')</script>",
+    )
+    client_malicious = TestClient(app_malicious)
+    response = client_malicious.get("/docs")
+    assert response.status_code == 200
+    content = response.text
+    
+    # Title should be escaped
+    assert "&lt;script&gt;alert('xss')&lt;/script&gt;" in content
+
+if __name__ == "__main__":
+    try:
+        test_openapi_root_path()
+        print("test_openapi_root_path passed")
+        test_swagger_ui_escaping()
+        print("test_swagger_ui_escaping passed")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
