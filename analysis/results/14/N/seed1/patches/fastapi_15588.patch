--- /dev/null
+++ b/repro.py
@@ -0,0 +1,45 @@
+
+from fastapi.sse import ServerSentEvent, format_sse_event
+import pytest
+
+def test_sse_event_newline():
+    try:
+        ServerSentEvent(event="multi\nline")
+        print("FAILED: ServerSentEvent(event='multi\\nline') should have raised ValueError")
+    except ValueError as e:
+        print(f"PASSED: ServerSentEvent(event='multi\\nline') raised ValueError: {e}")
+
+def test_sse_id_newline():
+    try:
+        ServerSentEvent(id="multi\nline")
+        print("FAILED: ServerSentEvent(id='multi\\nline') should have raised ValueError")
+    except ValueError as e:
+        print(f"PASSED: ServerSentEvent(id='multi\\nline') raised ValueError: {e}")
+
+def test_sse_id_null():
+    try:
+        ServerSentEvent(id="null\0char")
+        print("FAILED: ServerSentEvent(id='null\\0char') should have raised ValueError")
+    except ValueError as e:
+        print(f"PASSED: ServerSentEvent(id='null\\0char') raised ValueError: {e}")
+
+def test_format_sse_event_newline_event():
+    try:
+        format_sse_event(event="multi\nline")
+        print("FAILED: format_sse_event(event='multi\\nline') should have raised ValueError")
+    except ValueError as e:
+        print(f"PASSED: format_sse_event(event='multi\\nline') raised ValueError: {e}")
+
+def test_format_sse_event_newline_id():
+    try:
+        format_sse_event(id="multi\nline")
+        print("FAILED: format_sse_event(id='multi\\nline') should have raised ValueError")
+    except ValueError as e:
+        print(f"PASSED: format_sse_event(id='multi\\nline') raised ValueError: {e}")
+
+if __name__ == "__main__":
+    test_sse_event_newline()
+    test_sse_id_newline()
+    test_sse_id_null()
+    test_format_sse_event_newline_event()
+    test_format_sse_event_newline_id()
