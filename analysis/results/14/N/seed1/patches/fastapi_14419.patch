@@ -0,0 +1,31 @@
+import pytest
+from fastapi import FastAPI, Depends, Security
+from fastapi.security.oauth2 import SecurityScopes
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+call_count = 0
+
+def get_dep(security_scopes: SecurityScopes = SecurityScopes()):
+    global call_count
+    call_count += 1
+    return "value"
+
+@app.get("/")
+def read_root(dep1: str = Depends(get_dep), dep2: str = Security(get_dep, scopes=[])):
+    return {"dep1": dep1, "dep2": dep2}
+
+client = TestClient(app)
+
+def test_depends_security_cache():
+    global call_count
+    call_count = 0
+    response = client.get("/")
+    assert response.status_code == 200
+    assert response.json() == {"dep1": "value", "dep2": "value"}
+    assert call_count == 1
+
+if __name__ == "__main__":
+    test_depends_security_cache()
+    print("Test passed!")
