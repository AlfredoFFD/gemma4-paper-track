@@ -0,0 +1,50 @@
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+
+class Cat(BaseModel):
+    meow: bool
+    kind: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    kind: Literal["dog"]
+
+CatDog = Annotated[Union[Cat, Dog], Field(discriminator="kind")]
+
+app = FastAPI()
+
+@app.post("/items")
+async def create_item(item: Annotated[CatDog, Body()]):
+    return item
+
+client = TestClient(app)
+
+def test_tagged_union_body():
+    # Test Cat
+    response = client.post("/items", json={"kind": "cat", "meow": True})
+    assert response.status_code == 200
+    assert response.json() == {"kind": "cat", "meow": True}
+
+    # Test Dog
+    response = client.post("/items", json={"kind": "dog", "bark": True})
+    assert response.status_code == 200
+    assert response.json() == {"kind": "dog", "bark": True}
+
+    # Test invalid discriminator
+    response = client.post("/items", json={"kind": "bird", "fly": True})
+    assert response.status_code == 422
+
+    # Test missing discriminator
+    response = client.post("/items", json={"meow": True})
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_tagged_union_body()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
