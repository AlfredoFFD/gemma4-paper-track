diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..507e4b35
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,67 @@
+
+import asyncio
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.dependencies.utils import solve_dependencies, SecurityScopes
+from starlette.requests import Request
+from contextlib import AsyncExitStack
+
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+captured_scopes = []
+
+from typing import Any
+
+async def dep_b(security_scopes: Any = Security(oauth2_scheme, scopes=["read"])):
+    captured_scopes.append(set(security_scopes.scopes))
+    return "dep_b"
+
+async def dep_a(security_scopes: Any = Security(oauth2_scheme, scopes=["user"]), b=Depends(dep_b)):
+    captured_scopes.append(set(security_scopes.scopes))
+    return "dep_a"
+
+async def root(security_scopes: Any = Security(oauth2_scheme, scopes=["admin"]), a=Depends(dep_a)):
+    captured_scopes.append(set(security_scopes.scopes))
+    return "root"
+
+async def test_hierarchical_scopes():
+    app = FastAPI()
+    @app.get("/")
+    async def read_root(res=Depends(root)):
+        return res
+
+    app.dependency_overrides[oauth2_scheme] = lambda: "token"
+
+    request = Request({"type": "http", "path": "/"})
+    request.scope["fastapi_inner_astack"] = AsyncExitStack()
+    request.scope["fastapi_function_astack"] = AsyncExitStack()
+    
+    route = app.routes[0]
+    dependant = route.dependant
+    
+    await solve_dependencies(
+        request=request,
+        dependant=dependant,
+        body=None,
+        background_tasks=None,
+        response=None,
+        dependency_overrides_provider=lambda: app.dependency_overrides,
+        dependency_cache={},
+        async_exit_stack=AsyncExitStack(),
+        embed_body_fields=False,
+    )
+    
+    print(f"Captured scopes: {captured_scopes}")
+    # Expected:
+    # dep_b: {'read', 'user', 'admin'}
+    # dep_a: {'user', 'admin'}
+    # root: {'admin'}
+    
+    # The order of execution is dep_b -> dep_a -> root
+    assert len(captured_scopes) == 3
+    assert captured_scopes[0] == {"read", "user", "admin"}
+    assert captured_scopes[1] == {"user", "admin"}
+    assert captured_scopes[2] == {"admin"}
+    print("Test passed!")
+
+if __name__ == "__main__":
+    asyncio.run(test_hierarchical_scopes())
