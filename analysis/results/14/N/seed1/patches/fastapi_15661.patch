+import argparse
+import re
+import sys
+import subprocess
+from pathlib import Path
+
+VERSION_FILE = Path("fastapi/__init__.py")
+RELEASE_NOTES_FILE = Path("docs/en/docs/release-notes.md")
+
+def update_version(new_version: str):
+    content = VERSION_FILE.read_text()
+    new_content = re.sub(r'(__version__ = ")(.*)(")', rf'\g<1>{new_version}\g<3>', content)
+    VERSION_FILE.write_text(new_content)
+    print(f"Updated version to {new_version} in {VERSION_FILE}")
+
+def update_release_notes(new_version: str):
+    content = RELEASE_NOTES_FILE.read_text()
+    if "## Latest Changes" not in content:
+        print("Error: '## Latest Changes' not found in release notes.")
+        sys.exit(1)
+    
+    # Replace only the first occurrence of ## Latest Changes
+    new_content = re.sub(r'^## Latest Changes$', f'## {new_version}', content, flags=re.MULTILINE)
+    if new_content == content:
+        # Try without anchors if it failed
+        new_content = content.replace("## Latest Changes", f"## {new_version}", 1)
+        
+    RELEASE_NOTES_FILE.write_text(new_content)
+    print(f"Updated release notes for version {new_version}")
+
+def main():
+    parser = argparse.ArgumentParser(description="Automate release preparation")
+    parser.add_argument("version", help="The new version to release (e.g., 0.136.4)")
+    args = parser.parse_args()
+
+    update_version(args.version)
+    update_release_notes(args.version)
+    
+    # Call add_latest_release_date.py
+    subprocess.run([sys.executable, "scripts/add_latest_release_date.py"], check=True)
+    print("Added release date to release notes.")
+
+if __name__ == "__main__":
+    main()
