+def _is_callable_type(call: Any, check_func: Callable[[Any], bool]) -> bool:
+    if call is None:
+        return False
+    try:
+        if check_func(call):
+            return True
+    except Exception:
+        pass
+    if isinstance(call, partial):
+        if _is_callable_type(call.func, check_func):
+            return True
+    if not inspect.isroutine(call):
+        dunder_call = getattr(call, "__call__", None)
+        if dunder_call and _is_callable_type(dunder_call, check_func):
+            return True
+    unwrapped = inspect.unwrap(call)
+    if unwrapped is not call:
+        if _is_callable_type(unwrapped, check_func):
+            return True
+    return False
