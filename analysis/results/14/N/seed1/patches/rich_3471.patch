+from rich.text import Text
+
+def test_append_tokens():
+    t = Text("Hello")
+    print(f"Initial: {t.plain}, length: {len(t)}")
+    
+    # Normal case
+    t.append_tokens([(" world", None), ("!", "bold")])
+    print(f"After normal: {t.plain}, length: {len(t)}")
+    
+    # Empty case
+    t.append_tokens([])
+    print(f"After empty: {t.plain}, length: {len(t)}")
+    
+    # Generator case
+    def gen():
+        yield (" more", None)
+        yield (" text", "italic")
+    t.append_tokens(gen())
+    print(f"After generator: {t.plain}, length: {len(t)}")
+
+if __name__ == "__main__":
+    test_append_tokens()
