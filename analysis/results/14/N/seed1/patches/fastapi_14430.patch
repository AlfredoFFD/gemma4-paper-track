@@ -0,0 +1,73 @@
+from typing import Union, Optional, List, Dict, Any, Type
+from fastapi._compat import shared
+import types
+
+def test_field_annotation_is_sequence():
+    test_cases = [
+        (List[int], True),
+        (Optional[List[int]], True),
+        (List[int] | None, True),
+        (List[int] | List[str], True),
+        (List[int] | int, True),
+        (List[int] | Dict[str, int], True),
+        (int, False),
+        (Optional[int], False),
+        (int | None, False),
+        (None, False),
+    ]
+    for annotation, expected in test_cases:
+        result = shared.field_annotation_is_sequence(annotation)
+        print(f"{annotation}: expected {expected}, got {result}")
+        assert result == expected, f"Failed for {annotation}"
+
+def test_field_annotation_is_scalar():
+    test_cases = [
+        (int, True),
+        (Optional[int], True),
+        (int | None, True),
+        (List[int], False),
+        (Optional[List[int]], False),
+        (List[int] | None, False),
+        (None, True),
+    ]
+    for annotation, expected in test_cases:
+        result = shared.field_annotation_is_scalar(annotation)
+        print(f"{annotation}: expected {expected}, got {result}")
+        assert result == expected, f"Failed for {annotation}"
+
+def test_field_annotation_is_scalar_sequence():
+    test_cases = [
+        (List[int], True),
+        (Optional[List[int]], True),
+        (List[int] | None, True),
+        (List[int] | List[str], True),
+        (List[int] | int, True),
+        (List[int] | Dict[str, int], False),
+        (int, False),
+        (Optional[int], False),
+        (int | None, False),
+        (None, False),
+    ]
+    for annotation, expected in test_cases:
+        result = shared.field_annotation_is_scalar_sequence(annotation)
+        print(f"{annotation}: expected {expected}, got {result}")
+        assert result == expected, f"Failed for {annotation}"
+
+if __name__ == "__main__":
+    try:
+        test_field_annotation_is_sequence()
+        print("test_field_annotation_is_sequence passed")
+    except AssertionError as e:
+        print(f"test_field_annotation_is_sequence failed: {e}")
+
+    try:
+        test_field_annotation_is_scalar()
+        print("test_field_annotation_is_scalar passed")
+    except AssertionError as e:
+        print(f"test_field_annotation_is_scalar failed: {e}")
+
+    try:
+        test_field_annotation_is_scalar_sequence()
+        print("test_field_annotation_is_scalar_sequence passed")
+    except AssertionError as e:
+        print(f"test_field_annotation_is_scalar_sequence failed: {e}")
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..9fa7041f
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,27 @@
+from fastapi import FastAPI, Query
+from fastapi.testclient import TestClient
+from typing import List, Optional
+import pytest
+
+app = FastAPI()
+
+@app.get("/test-optional-list")
+def test_optional_list(q: list[str] | list[int] | None = Query(None)):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_optional_list_union_syntax():
+    # This should work and return a list
+    response = client.get("/test-optional-list?q=a&q=b")
+    assert response.status_code == 200
+    assert response.json() == {"q": ["a", "b"]}
+
+    # This should work and return None
+    response = client.get("/test-optional-list")
+    assert response.status_code == 200
+    assert response.json() == {"q": None}
+
+if __name__ == "__main__":
+    test_optional_list_union_syntax()
+    print("Test passed!")
