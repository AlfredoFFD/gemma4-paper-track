+from typing import Union, List, Optional, get_origin, get_args
+import types
+from fastapi._compat import shared
+
+def test_field_annotation_is_sequence():
+    print(f"list[int]: {shared.field_annotation_is_sequence(list[int])}")
+    print(f"Optional[list[int]]: {shared.field_annotation_is_sequence(Optional[list[int]])}")
+    print(f"list[int] | None: {shared.field_annotation_is_sequence(list[int] | None)}")
+    print(f"list[int] | list[str]: {shared.field_annotation_is_sequence(list[int] | list[str])}")
+    print(f"list[int] | int: {shared.field_annotation_is_sequence(list[int] | int)}")
+    print(f"list[int] | dict[str, int]: {shared.field_annotation_is_sequence(list[int] | dict[str, int])}")
+
+def test_field_annotation_is_scalar_sequence():
+    print(f"list[int]: {shared.field_annotation_is_scalar_sequence(list[int])}")
+    print(f"Optional[list[int]]: {shared.field_annotation_is_scalar_sequence(Optional[list[int]])}")
+    print(f"list[int] | None: {shared.field_annotation_is_scalar_sequence(list[int] | None)}")
+    print(f"list[int] | list[str]: {shared.field_annotation_is_scalar_sequence(list[int] | list[str])}")
+    print(f"list[int] | int: {shared.field_annotation_is_scalar_sequence(list[int] | int)}")
+    print(f"list[int] | dict[str, int]: {shared.field_annotation_is_scalar_sequence(list[int] | dict[str, int])}")
+
+if __name__ == "__main__":
+    print("Testing field_annotation_is_sequence:")
+    test_field_annotation_is_sequence()
