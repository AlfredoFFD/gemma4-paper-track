diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..dc1cd416
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,22 @@
+
+from copy import deepcopy
+
+def _replace_refs(schema, old_name_to_new_name_map):
+    new_schema = deepcopy(schema)
+    for key, value in new_schema.items():
+        if key == "$ref":
+            # This is the line we are talking about
+            value = schema["$ref"]
+            if isinstance(value, str):
+                ref_name = schema["$ref"].split("/")[-1]
+                if ref_name in old_name_to_new_name_map:
+                    new_name = old_name_to_new_name_map[ref_name]
+                    new_schema["$ref"] = "new_ref"
+            continue
+        if isinstance(value, dict):
+            new_schema[key] = _replace_refs(value, old_name_to_new_name_map)
+    return new_schema
+
+schema = {"$ref": "foo"}
+old_name_to_new_name_map = {"foo": "bar"}
+print(_replace_refs(schema, old_name_to_new_name_map))
