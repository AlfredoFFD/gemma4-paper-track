--- /dev/null
+++ b/repro.py
@@ -0,0 +1,28 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.openapi.utils import get_openapi
+import json
+
+app = FastAPI()
+
+scheme1 = OAuth2PasswordBearer(
+    tokenUrl="token", 
+    scopes={"read": "Read access"}, 
+    scheme_name="my_scheme"
+)
+scheme2 = OAuth2PasswordBearer(
+    tokenUrl="token", 
+    scopes={"write": "Write access"}, 
+    scheme_name="my_scheme"
+)
+
+@app.get("/read", dependencies=[Security(scheme1, scopes=["read"])])
+def read():
+    return {"message": "read"}
+
+@app.get("/write", dependencies=[Security(scheme2, scopes=["write"])])
+def write():
+    return {"message": "write"}
+
+openapi_schema = app.openapi()
+print(json.dumps(openapi_schema, indent=2))
