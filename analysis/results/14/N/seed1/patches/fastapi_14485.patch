@@ -0,0 +1,21 @@
+
+from __future__ import annotations
+import inspect
+from typing import TYPE_CHECKING, ForwardRef
+from fastapi.dependencies.utils import get_typed_signature
+
+if TYPE_CHECKING:
+    class User:
+        pass
+
+def my_endpoint(user: User):
+    return {"user": user}
+
+try:
+    sig = get_typed_signature(my_endpoint)
+    print("Successfully got signature")
+    print(f"User annotation: {sig.parameters['user'].annotation}")
+except Exception as e:
+    print(f"Caught exception: {type(e).__name__}: {e}")
+    import traceback
+    traceback.print_exc()
