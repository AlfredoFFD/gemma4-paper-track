index 00000000..f4c4a646
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,16 @@
+from rich.console import Console
+from rich.markup import _parse
+
+def test_trailing_backslash():
+    markup = "hello \\"
+    print(f"Markup: {markup!r}")
+    print(f"Parsed: {list(_parse(markup))}")
+
+def test_trailing_backslash_escaped():
+    markup = "hello \\\\"
+    print(f"Markup: {markup!r}")
+    print(f"Parsed: {list(_parse(markup))}")
+
+if __name__ == "__main__":
+    test_trailing_backslash()
+    test_trailing_backslash_escaped()
