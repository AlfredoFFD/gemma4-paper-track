+from rich.markup import _parse
+
+def test_parse(markup):
+    print(f"Markup: {markup!r} -> Parsed: {list(_parse(markup))}")
+
+test_parse("hello \\")
+test_parse("hello \\\\")
+test_parse("hello \\\\\\")
+test_parse("hello \\\\\\\\")
