@@ -0,0 +1,26 @@
+
+from fastapi import Depends, Security
+
+def test_depends_hashable():
+    d1 = Depends(dependency=lambda: None)
+    d2 = Depends(dependency=lambda: None)
+    # This should fail if not hashable
+    try:
+        hash(d1)
+        print("Depends is hashable")
+    except TypeError as e:
+        print(f"Depends is not hashable: {e}")
+
+def test_security_hashable():
+    s1 = Security(dependency=lambda: None)
+    s2 = Security(dependency=lambda: None)
+    # This should fail if not hashable
+    try:
+        hash(s1)
+        print("Security is hashable")
+    except TypeError as e:
+        print(f"Security is not hashable: {e}")
+
+if __name__ == "__main__":
+    test_depends_hashable()
+    test_security_hashable()
