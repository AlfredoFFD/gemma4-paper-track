index 00000000..dd433470
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,31 @@
+
+from fastapi import FastAPI, APIRouter
+from fastapi.exceptions import FastAPIError
+import pytest
+
+def test_include_router_self():
+    router = APIRouter()
+    router.get("/test")
+    
+    with pytest.raises(FastAPIError) as excinfo:
+        router.include_router(router)
+    assert "You cannot include a router into itself." in str(excinfo.value)
+
+def test_include_router_self_fastapi():
+    app = FastAPI()
+    app.get("/test")
+    
+    with pytest.raises(FastAPIError) as excinfo:
+        app.include_router(app.router)
+    assert "You cannot include a router into itself." in str(excinfo.value)
+
+if __name__ == "__main__":
+    try:
+        test_include_router_self()
+        print("test_include_router_self passed")
+        test_include_router_self_fastapi()
+        print("test_include_router_self_fastapi passed")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e
