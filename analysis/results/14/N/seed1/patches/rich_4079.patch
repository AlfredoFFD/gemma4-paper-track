+from rich.console import Console
+from rich.markdown import Markdown
+
+markdown_text = """
+| Header 1 | Header 2 |
+| --- | --- |
+| `inline code` | normal text |
+"""
+
+console = Console(record=True)
+console.print(Markdown(markdown_text))
+print(console.export())
