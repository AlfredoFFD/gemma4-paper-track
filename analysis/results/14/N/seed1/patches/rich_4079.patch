new file mode 100644
index 00000000..035ad39b
--- /dev/null
+++ b/inspect_markdown.py
@@ -0,0 +1,25 @@
+from rich.markdown import Markdown
+from rich.console import Console
+from rich.text import Text
+
+markdown_text = """
+| Header 1 | Header 2 |
+| --- | --- |
+| `inline code` | normal text |
+"""
+
+md = Markdown(markdown_text)
+console = Console()
+options = console.options
+
+for renderable in md.__rich_console__(console, options):
+    print(f"Renderable type: {type(renderable)}")
+    if hasattr(renderable, "rows"):
+        for row in renderable.rows:
+            for cell in row.cells:
+                # cell is a Text object
+                print(f"Cell content: {cell}")
+                print(f"Cell styles: {cell.style}")
+                # To see all styles in the Text object, we can iterate over its spans
+                for span in cell.spans:
+                    print(f"Span: {span.text}, Style: {span.style}")
