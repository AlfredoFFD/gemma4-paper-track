new file mode 100644
index 00000000..3cede586
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,10 @@
+from rich.console import Console
+from rich.syntax import Syntax
+import io
+
+code = "print('hello')"
+output = io.StringIO()
+console = Console(file=output, width=40, force_terminal=False)
+syntax_tuple = Syntax(code, "python", padding=(1, 2, 3, 4))
+console.print(syntax_tuple)
+print(output.getvalue())
