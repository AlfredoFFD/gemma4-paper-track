diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..ca169c1e
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,23 @@
+from rich.console import Console
+
+def test_record_capture():
+    console = Console(record=True)
+    with console.capture() as capture:
+        console.print("Hello captured world!")
+    
+    captured_text = capture.get()
+    print(f"Captured: {captured_text!r}")
+    
+    recorded_text = console.export_text()
+    print(f"Recorded: {recorded_text!r}")
+    
+    assert "Hello captured world!" in captured_text
+    assert "Hello captured world!" in recorded_text
+
+if __name__ == "__main__":
+    try:
+        test_record_capture()
+        print("Test passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        raise e
diff --git a/repro_multiple.py b/repro_multiple.py
new file mode 100644
index 00000000..ad77db80
--- /dev/null
+++ b/repro_multiple.py
@@ -0,0 +1,23 @@
+from rich.console import Console
+
+def test_record_capture_multiple():
+    console = Console(record=True)
+    with console.capture() as capture:
+        console.print("Hello")
+        console.print("World")
+    
+    recorded_text = console.export_text()
+    print(f"Recorded: {recorded_text!r}")
+    
+    expected = "Hello\nWorld\n"
+    if recorded_text != expected:
+        print(f"Expected: {expected!r}")
+        raise AssertionError(f"Recorded text does not match expected. Got {recorded_text!r}")
+
+if __name__ == "__main__":
+    try:
+        test_record_capture_multiple()
+        print("Test passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        raise e
