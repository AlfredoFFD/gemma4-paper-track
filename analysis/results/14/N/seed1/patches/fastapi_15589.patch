@@ -0,0 +1,38 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/test")
+def read_header(x_header: str = Header(convert_underscores=False)):
+    return {"x_header": x_header}
+
+client = TestClient(app)
+
+def test_underscore_header_accepted_when_false():
+    # convert_underscores=False
+    # Should accept x_header
+    response = client.get("/test", headers={"x_header": "foo"})
+    print(f"Response with x_header: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"x_header": "foo"}
+
+def test_hyphen_header_rejected_when_false():
+    # convert_underscores=False
+    # Should NOT accept x-header
+    response = client.get("/test", headers={"x-header": "foo"})
+    print(f"Response with x-header: {response.json()}")
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_underscore_header_accepted_when_false()
+        print("test_underscore_header_accepted_when_false passed")
+    except Exception as e:
+        print(f"test_underscore_header_accepted_when_false failed: {e}")
+
+    try:
+        test_hyphen_header_rejected_when_false()
+        print("test_hyphen_header_rejected_when_false passed")
+    except Exception as e:
+        print(f"test_hyphen_header_rejected_when_false failed: {e}")
