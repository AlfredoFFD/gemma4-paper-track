diff --git a/reproduce_ansi.py b/reproduce_ansi.py
new file mode 100644
index 00000000..5fa03b83
--- /dev/null
+++ b/reproduce_ansi.py
@@ -0,0 +1,13 @@
+from rich.console import Console
+from rich.text import Text
+
+# Create a console that doesn't use a real terminal but allows ANSI colors
+console = Console(force_terminal=True, width=20)
+
+text = Text("This is a long text with a background color that should wrap correctly.", style="on blue")
+
+print("--- soft_wrap=False ---")
+console.print(text, soft_wrap=False)
+
+print("\n--- soft_wrap=True ---")
+console.print(text, soft_wrap=True)
diff --git a/reproduce_ansi_2.py b/reproduce_ansi_2.py
