diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..d1c3825b
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,31 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+from fastapi.openapi.utils import get_openapi
+
+app = FastAPI()
+
+class NestedModel(BaseModel):
+    name: str
+
+class MainModel(BaseModel):
+    nested: NestedModel
+
+@app.get("/test", response_model=MainModel)
+def read_test():
+    return {"nested": {"name": "test"}}
+
+openapi_schema = get_openapi(
+    title="Test",
+    version="1.0",
+    openapi_version="3.1.0",
+    routes=app.routes,
+    separate_input_output_schemas=True
+)
+
+definitions = openapi_schema.get("components", {}).get("schemas", {})
+print(f"Definitions: {list(definitions.keys())}")
+
+assert "NestedModel-Input" in definitions
+assert "NestedModel-Output" in definitions
+assert "MainModel-Output" in definitions
+print("Success!")
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..1b3dcc1a
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,31 @@
+from fastapi import FastAPI
+from pydantic import BaseModel
+from fastapi.testclient import TestClient
+from typing import List
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+
+class User(BaseModel):
+    username: str
+    items: List[Item]
+
+@app.post("/users", response_model=User)
+def create_user(user: User):
+    return user
+
+client = TestClient(app)
+
+def test_openapi_schemas():
+    response = client.get("/openapi.json")
+    data = response.json()
+    schemas = data.get("components", {}).get("schemas", {})
+    print(f"Schemas: {list(schemas.keys())}")
+    assert "User" in schemas
+    assert "Item" in schemas
+
+if __name__ == "__main__":
+    test_openapi_schemas()
+    print("Test passed!")
