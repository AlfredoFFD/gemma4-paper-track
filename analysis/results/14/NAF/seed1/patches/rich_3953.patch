+from rich.cells import cell_len, split_graphemes
+
+test_cases = [
+    ("\u200dA", 1),
+    ("A\u200d", 1),
+    ("\u200d", 0),
+    ("A\u200dB", 1),
+    ("A\u200d\u200dB", 2),
+]
+
+for text, expected in test_cases:
+    actual = cell_len(text)
+    print(f"text={repr(text)}, expected={expected}, actual={actual}")
+    assert actual == expected, f"cell_len failed for {repr(text)}"
+
+for text, expected in test_cases:
+    spans, width = split_graphemes(text)
+    print(f"text={repr(text)}, expected_width={expected}, actual_width={width}, spans={spans}")
+    assert width == expected, f"split_graphemes width failed for {repr(text)}"
