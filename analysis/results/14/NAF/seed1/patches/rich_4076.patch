+
+console = Console(force_terminal=True, width=20)
+
+print("Test 1: Simple newline")
+console.print("line1\nline2")
+
+print("\nTest 2: Multiple newlines")
+console.print("line1\n\nline2")
+
+print("\nTest 3: Trailing newline")
+console.print("line1\n")
+
+print("\nTest 4: Text object with newline")
+console.print(Text("line1\nline2"))
+
+print("\nTest 5: Text object with multiple newlines")
