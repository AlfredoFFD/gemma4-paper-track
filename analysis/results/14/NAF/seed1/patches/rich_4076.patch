--- /dev/null
+++ b/repro_split_bug.py
@@ -0,0 +1,11 @@
+from rich.text import Text
+
+text = Text("a\n\n")
+split_rich = text.split()
+split_python = "a\n\n".split("\n")
+
+print(f"Rich split: {repr(split_rich)}")
+print(f"Python split: {repr(split_python)}")
+
+if len(split_rich) != len(split_python):
+    print("BUG FOUND: Rich split lost a newline!")
diff --git a/repro_trailing_newline.py b/repro_trailing_newline.py
new file mode 100644
index 00000000..40b9c852
--- /dev/null
+++ b/repro_trailing_newline.py
@@ -0,0 +1,13 @@
+from rich.text import Text
+from rich.console import Console
+from io import StringIO
+
+console = Console(file=StringIO(), force_terminal=False)
+text = Text("\n\n")
+wrapped = text.wrap(console, 80)
+print(f"Wrapped: {repr(wrapped)}")
+
+# Now let's see what happens when we render it
+console.print(text)
+output = console.file.getvalue()
+print(f"Output: {repr(output)}")
