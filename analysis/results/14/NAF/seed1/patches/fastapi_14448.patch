+def _is_callable_recursive(call: Any, check_func: Callable[[Any], bool]) -> bool:
+    current = call
+    while current is not None:
+        if inspect.isroutine(current):
+            if check_func(current):
+                return True
+        elif not inspect.isclass(current) and hasattr(current, "__call__"):
+            if check_func(getattr(current, "__call__", None)):
+                return True
+
+        if isinstance(current, partial):
+            current = current.func
+        elif hasattr(current, "__wrapped__"):
+            current = current.__wrapped__
+        else:
+            break
+    return False
+
