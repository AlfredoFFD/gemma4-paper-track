diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..ae84884d
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,20 @@
+from rich.console import Console
+from rich.text import Text
+
+console = Console(force_terminal=True)
+
+print("Test 1: String with end")
+console.print("Hello", end="!!!")
+print("\n---")
+
+print("Test 2: Empty string with end")
+console.print("", end="!!!")
+print("\n---")
+
+print("Test 3: Text object with end")
+console.print(Text("Hello"), end="!!!")
+print("\n---")
+
+print("Test 4: Empty Text object with end")
+console.print(Text(""), end="!!!")
+print("\n---")
