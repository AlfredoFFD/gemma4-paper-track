+def merge_security_schemes(existing: Dict[str, Any], new: Dict[str, Any]) -> Dict[str, Any]:
+    for name, scheme in new.items():
+        if name in existing and existing[name].get("type") == "oauth2" and scheme.get("type") == "oauth2":
+            existing_flows = existing[name].get("flows", {})
+            new_flows = scheme.get("flows", {})
+            for flow_name, flow_details in new_flows.items():
+                if flow_name in existing_flows:
+                    existing_scopes = existing_flows[flow_name].get("scopes", {})
+                    new_scopes = flow_details.get("scopes", {})
+                    existing_flows[flow_name]["scopes"] = {**existing_scopes, **new_scopes}
+                else:
+                    existing_flows[flow_name] = flow_details
+            existing[name]["flows"] = existing_flows
+        else:
+            existing[name] = scheme
+    return existing
+
