diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..70d93275
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,34 @@
+
+from fastapi import FastAPI, Depends
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.openapi.utils import get_openapi
+import json
+
+app = FastAPI()
+
+auth1 = OAuth2PasswordBearer(tokenUrl="token", scopes={"read": "Read access"})
+auth2 = OAuth2PasswordBearer(tokenUrl="token", scopes={"write": "Write access"})
+
+@app.get("/read", dependencies=[Depends(auth1)])
+def read():
+    return {"message": "read"}
+
+@app.get("/write", dependencies=[Depends(auth2)])
+def write():
+    return {"message": "write"}
+
+openapi_schema = app.openapi()
+security_schemes = openapi_schema.get("components", {}).get("securitySchemes", {})
+
+print(json.dumps(security_schemes, indent=2))
+
+# Check if both scopes are present in the OAuth2PasswordBearer scheme
+oauth2_scheme = security_schemes.get("OAuth2PasswordBearer", {})
+flows = oauth2_scheme.get("flows", {})
+password_flow = flows.get("password", {})
+scopes = password_flow.get("scopes", {})
+
+print(f"Scopes: {scopes}")
+
+assert "read" in scopes
+assert "write" in scopes
