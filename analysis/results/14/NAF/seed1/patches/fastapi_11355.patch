new file mode 100644
index 00000000..593698e7
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,26 @@
+
+from __future__ import annotations
+import inspect
+from typing import ForwardRef, get_type_hints, Any, Dict
+from fastapi.dependencies.utils import get_typed_signature
+
+class MyModel:
+    pass
+
+def test_func(a: MyModel, b: str):
+    pass
+
+def test_repro():
+    print(f"Function: {test_func}")
+    sig = inspect.signature(test_func)
+    print(f"Inspect signature params: {sig.parameters}")
+    for name, param in sig.parameters.items():
+        print(f"Param {name} annotation: {param.annotation} (type: {type(param.annotation)})")
+
+    typed_sig = get_typed_signature(test_func)
+    print(f"Typed signature params: {typed_sig.parameters}")
+    for name, param in typed_sig.parameters.items():
+        print(f"Typed param {name} annotation: {param.annotation} (type: {type(param.annotation)})")
+
+if __name__ == "__main__":
+    test_repro()
