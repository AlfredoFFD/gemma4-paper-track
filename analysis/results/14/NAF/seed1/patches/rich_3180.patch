diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..b90d78cd
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,15 @@
+from rich._wrap import divide_line
+from rich.cells import chop_cells
+
+def test_divide_line():
+    text = "\u3042\u3042\u3042\u3042" # 4 double-width characters = 8 cells
+    width = 3
+    
+    chopped_words = chop_cells(text, max_size=width, position=0)
+    print(f"Chopped words: {chopped_words}")
+    
+    divides = divide_line(text, width, fold=True)
+    print(f"Text: {text}, Width: {width}, Divides: {divides}")
+
+if __name__ == '__main__':
+    test_divide_line()
