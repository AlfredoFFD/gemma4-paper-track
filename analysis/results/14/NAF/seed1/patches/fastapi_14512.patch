+import json
+
+class Cat(BaseModel):
+    meow: bool
+    kind: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    kind: Literal["dog"]
+
+CatDog = Annotated[Union[Cat, Dog], Field(discriminator="kind")]
+
+app = FastAPI()
+
+@app.post("/items")
+async def create_item(item: Annotated[CatDog, Body()]):
+    return item
+
+if __name__ == "__main__":
+    print(json.dumps(app.openapi(), indent=2))
