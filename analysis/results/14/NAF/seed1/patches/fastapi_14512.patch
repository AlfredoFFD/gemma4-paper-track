@@ -0,0 +1,48 @@
+from fastapi import FastAPI, Body
+from fastapi.openapi.utils import get_openapi
+from pydantic import BaseModel, Field
+from typing import Union, Annotated
+
+app = FastAPI()
+
+class Cat(BaseModel):
+    kind: str = "cat"
+    meow: str
+
+class Dog(BaseModel):
+    kind: str = "dog"
+    bark: str
+
+@app.post("/pet")
+async def create_pet(
+    pet: Annotated[Union[Cat, Dog], Field(discriminator="kind"), Body()]
+):
+    return pet
+
+openapi_schema = get_openapi(
+    title="Test API",
+    version="1.0.0",
+    routes=app.routes,
+)
+import json
+print(json.dumps(openapi_schema, indent=2))
+
+# Verification
+paths = openapi_schema.get("paths", {})
+post_pet = paths.get("/pet", {}).get("post", {})
+request_body = post_pet.get("requestBody", {})
+content = request_body.get("content", {})
+application_json = content.get("application/json", {})
+schema = application_json.get("schema", {})
+
+if "oneOf" in schema:
+    print("Found oneOf")
+elif "anyOf" in schema:
+    print("Found anyOf")
+else:
+    print("Found neither oneOf nor anyOf")
+
+if "discriminator" in schema:
+    print("Found discriminator!")
+else:
+    print("Discriminator MISSING!")
