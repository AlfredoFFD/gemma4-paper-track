diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..952828ba
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,67 @@
+import functools
+import pytest
+from fastapi import Depends, FastAPI
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+def sync_dep(value: "str"):
+    return value
+
+async def async_dep(value: "str"):
+    return value
+
+class CallableDep:
+    def __call__(self, value: "str"):
+        return value
+
+class AsyncCallableDep:
+    async def __call__(self, value: "str"):
+        return value
+
+sync_dep_partial = functools.partial(sync_dep, value="partial-sync")
+async_dep_partial = functools.partial(async_dep, value="partial-async")
+callable_dep_partial = functools.partial(CallableDep(), value="partial-callable")
+async_callable_dep_partial = functools.partial(AsyncCallableDep(), value="partial-async-callable")
+
+@app.get("/sync-partial")
+async def get_sync_partial(value: str = Depends(sync_dep_partial)):
+    return value
+
+@app.get("/async-partial")
+async def get_async_partial(value: str = Depends(async_dep_partial)):
+    return value
+
+@app.get("/callable-partial")
+async def get_callable_partial(value: str = Depends(callable_dep_partial)):
+    return value
+
+@app.get("/async-callable-partial")
+async def get_async_callable_partial(value: str = Depends(async_callable_dep_partial)):
+    return value
+
+client = TestClient(app)
+
+def test_sync_partial():
+    response = client.get("/sync-partial")
+    assert response.status_code == 200
+    assert response.json() == "partial-sync"
+
+def test_async_partial():
+    response = client.get("/async-partial")
+    assert response.status_code == 200
+    assert response.json() == "partial-async"
+
+def test_callable_partial():
+    response = client.get("/callable-partial")
+    assert response.status_code == 200
+    assert response.json() == "partial-callable"
+
+def test_async_callable_partial():
+    response = client.get("/async-callable-partial")
+    assert response.status_code == 200
+    assert response.json() == "partial-async-callable"
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__])
