index 00000000..715aa786
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,22 @@
+
+from fastapi import FastAPI, Query
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+@app.get("/test")
+async def test_endpoint(q: str = Query(validation_alias="query_alias")):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_validation_alias():
+    response = client.get("/test", params={"query_alias": "hello"})
+    print(f"Response status code: {response.status_code}")
+    print(f"Response body: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"q": "hello"}
+
+if __name__ == "__main__":
+    test_validation_alias()
