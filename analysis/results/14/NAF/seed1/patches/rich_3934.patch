+from rich.console import Console
+from rich.live import Live
+from rich.text import Text
+import time
+import sys
+
+# Use a file to capture raw output including control codes
+with open("output.txt", "w", encoding="utf-8") as f:
+    # We need to wrap the file in a way that Console thinks it's a terminal
+    # but actually writes to the file.
+    class FileConsole(Console):
+        def __init__(self, file):
+            super().__init__(file=file, force_terminal=True)
+
+    with FileConsole(f) as console:
+        console.print("Line 1")
+        with Live(Text(""), console=console) as live:
+            time.sleep(0.1)
+            console.print("Line 2")
+            time.sleep(0.1)
+        console.print("Done")
+
+with open("output.txt", "r", encoding="utf-8") as f:
+    print(repr(f.read()))
