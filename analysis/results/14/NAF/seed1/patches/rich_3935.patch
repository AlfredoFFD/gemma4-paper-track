@@ -0,0 +1,12 @@
+from rich.console import Console
+from rich.padding import Padding
+from rich.text import Text
+
+console = Console(width=2)
+# max_width = 2, left = 2, right = 2.
+# Content width will be 4.
+# Top/bottom padding width will be 2.
+renderable = Text("Hello")
+padding = Padding(renderable, (1, 2, 1, 2), expand=True)
+
+console.print(padding)
