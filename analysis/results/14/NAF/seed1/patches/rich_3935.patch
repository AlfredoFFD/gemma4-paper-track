--- /dev/null
+++ b/reproduce_padding.py
@@ -0,0 +1,17 @@
+from rich.console import Console
+from rich.padding import Padding
+from rich.text import Text
+
+console = Console(width=10)
+# Text is 10 chars. Padding is 2 left, 2 right.
+# Total width available is 10.
+# Inner width is 10 - 2 - 2 = 6.
+# Text will wrap to 6 chars.
+# Rendered width will be 6 + 2 = 8.
+# But Padding.__rich_console__ will calculate width = min(10 + 2 + 2, 10) = 10.
+# Top padding will be 10 spaces.
+
+renderable = Text("1234567890")
+padding = Padding(renderable, (1, 2, 1, 2), expand=False)
+
+console.print(padding)
