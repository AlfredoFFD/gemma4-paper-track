+from pydantic import Field, Json
+from pydantic.fields import FieldInfo
+from typing import Annotated, List
+from pydantic._internal._schema_generation_shared import GetJsonSchemaHandler # Not needed for this
+
+# In Pydantic v2, we can create a model and look at its fields
+from pydantic import BaseModel
+
+class Model(BaseModel):
+    tags: Annotated[Json[List[str]], Field()]
+
+field = Model.model_fields['tags']
+print(f"Field info: {field}")
+print(f"Metadata: {field.metadata}")
