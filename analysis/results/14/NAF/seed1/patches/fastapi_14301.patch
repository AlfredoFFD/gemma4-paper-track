index 00000000..7724ca20
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,25 @@
+import pytest
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+call_count = 0
+
+def dep():
+    global call_count
+    call_count += 1
+    return "hello"
+
+@app.get("/", dependencies=[Depends(dep, scope="function"), Depends(dep, scope="function")])
+def root():
+    return "hello"
+
+client = TestClient(app)
+
+def test_scope_function_top_level():
+    global call_count
+    call_count = 0
+    response = client.get("/")
+    assert response.status_code == 200
+    assert call_count == 2
