@@ -0,0 +1,42 @@
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from typing import Annotated, Union, Literal
+from pydantic import BaseModel, Field
+
+app = FastAPI()
+
+class Cat(BaseModel):
+    kind: Literal["cat"]
+    meow: str
+
+class Dog(BaseModel):
+    kind: Literal["dog"]
+    bark: str
+
+# Discriminated Union
+Pet = Annotated[Union[Cat, Dog], Field(discriminator="kind")]
+
+# Nested Annotated: Annotated[Pet, "some metadata"]
+# This should be recognized as a Body parameter.
+@app.post("/test")
+async def test_endpoint(item: Annotated[Pet, "some metadata"]):
+    return item
+
+client = TestClient(app)
+
+def test_nested_annotated_union_body():
+    # Test Cat
+    response = client.post("/test", json={"kind": "cat", "meow": "meow"})
+    print(f"Cat response status: {response.status_code}")
+    print(f"Cat response body: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"kind": "cat", "meow": "meow"}
+
+if __name__ == "__main__":
+    try:
+        test_nested_annotated_union_body()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import sys
+        sys.exit(1)
