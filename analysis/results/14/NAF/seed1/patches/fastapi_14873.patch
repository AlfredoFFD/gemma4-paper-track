diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..e807cb81
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,19 @@
+
+from fastapi import APIRouter
+import asyncio
+
+async def startup_handler():
+    print("Startup handler called!")
+    startup_handler.called = True
+
+startup_handler.called = False
+
+router = APIRouter(on_startup=[startup_handler])
+
+async def test_lifespan():
+    async with router.lifespan_context(None):
+        pass
+
+asyncio.run(test_lifespan())
+print(f"Startup handler called: {startup_handler.called}")
+assert startup_handler.called, "Startup handler was not called!"
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..68d450bd
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,23 @@
+from fastapi import FastAPI
+import asyncio
+
+def s_start():
+    print("SYNC START", flush=True)
+
+async def a_start():
+    print("ASYNC START", flush=True)
+
+app = FastAPI(on_startup=[s_start, a_start])
+
+@app.get("/health")
+async def health():
+    return {"ok": True}
+
+async def test_startup():
+    # We need to simulate the lifespan of the app
+    # In a real scenario, this is handled by the ASGI server
+    async with app.lifespan(None, None):
+        print("Lifespan context entered")
+
+if __name__ == "__main__":
+    asyncio.run(test_startup())
