diff --git a/repro.py b/repro.py
new file mode 100644
index 000000000..e09182f9c
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,44 @@
+
+from fastapi import FastAPI, Header, Depends
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+import pytest
+
+app = FastAPI()
+
+class HeaderModel(BaseModel):
+    my_header: str = Header(default="default", convert_underscores=True)
+
+@app.get("/")
+async def read_root(headers: HeaderModel = Depends()):
+    return {"headers": headers}
+
+client = TestClient(app)
+
+def test_underscore_header_rejected():
+    # This should NOT populate my_header because convert_underscores=True
+    # It should use the default value "default"
+    response = client.get("/", headers={"my_header": "underscore_value"})
+    print(f"Underscore test response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"headers": {"my_header": "default"}}
+
+def test_hyphen_header_accepted():
+    # This SHOULD populate my_header
+    response = client.get("/", headers={"my-header": "hyphen_value"})
+    print(f"Hyphen test response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"headers": {"my_header": "hyphen_value"}}
+
+if __name__ == "__main__":
+    try:
+        test_underscore_header_rejected()
+        print("Underscore test passed!")
+    except Exception as e:
+        print(f"Underscore test failed: {e}")
+    
+    try:
+        test_hyphen_header_accepted()
+        print("Hyphen test passed!")
+    except Exception as e:
+        print(f"Hyphen test failed: {e}")
