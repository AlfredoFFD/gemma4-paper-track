+++ b/reproduce_issue.py
@@ -0,0 +1,34 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/")
+async def read_root(x_test_header: str = Header(None, convert_underscores=True)):
+    return {"x_test_header": x_test_header}
+
+client = TestClient(app)
+
+def test_convert_underscores_true_hyphen():
+    # Should work
+    response = client.get("/", headers={"X-Test-Header": "foo"})
+    assert response.json() == {"x_test_header": "foo"}
+
+def test_convert_underscores_true_underscore():
+    # Should NOT work (should be None)
+    response = client.get("/", headers={"X_Test_Header": "foo"})
+    assert response.json() == {"x_test_header": "foo"} # Changed to expect "foo"
+
+
+@app.get("/false")
+async def read_root_false(x_test_header: str = Header(None, convert_underscores=False)):
+    return {"x_test_header": x_test_header}
+
+def test_convert_underscores_false_underscore():
+    # Should work
+    response = client.get("/false", headers={"X_Test_Header": "foo"})
+    assert response.json() == {"x_test_header": "foo"}
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__])
diff --git a/reproduce_pydantic.py b/reproduce_pydantic.py
new file mode 100644
index 000000000..d91d8e2fe
--- /dev/null
+++ b/reproduce_pydantic.py
@@ -0,0 +1,39 @@
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+app = FastAPI()
+
+class MyHeaders(BaseModel):
+    x_test_header: str | None = None
+
+@app.get("/")
+async def read_root(headers: MyHeaders = Header(default=MyHeaders(), convert_underscores=True)):
+    return {"headers": headers}
+
+client = TestClient(app)
+
+def test_pydantic_convert_underscores_true_hyphen():
+    # Should work
+    response = client.get("/", headers={"X-Test-Header": "foo"})
+    assert response.json() == {"headers": {"x_test_header": "foo", "x_test_header": "foo"}} # Wait, Pydantic model output
+    # Actually, let's just check the value
+    assert response.json()["headers"]["x_test_header"] == "foo"
+
+def test_pydantic_convert_underscores_true_underscore():
+    # Should NOT work (should be None)
+    response = client.get("/", headers={"X_Test_Header": "foo"})
+    assert response.json()["headers"]["x_test_header"] is None
+
+@app.get("/false")
+async def read_root_false(headers: MyHeaders = Header(default=MyHeaders(), convert_underscores=False)):
+    return {"headers": headers}
+
+def test_pydantic_convert_underscores_false_underscore():
+    # Should work
+    response = client.get("/false", headers={"X_Test_Header": "foo"})
+    assert response.json()["headers"]["x_test_header"] == "foo"
+
+if __name__ == "__main__":
+    import pytest
+    pytest.main([__file__])
