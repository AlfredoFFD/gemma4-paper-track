diff --git a/verify_graphemes.py b/verify_graphemes.py
new file mode 100644
index 00000000..9ba41964
--- /dev/null
+++ b/verify_graphemes.py
@@ -0,0 +1,63 @@
+from rich.cells import graphemes, chop_cells, set_cell_size
+from rich.text import Text
+
+def test_graphemes():
+    print("Testing graphemes()...")
+    test_cases = [
+        ("hello", ["h", "e", "l", "l", "o"]),
+        ("👋🌍", ["👋", "🌍"]),
+        ("👨‍👩‍👧‍👦", ["👨‍👩‍👧‍👦"]),
+        ("A\u0301", ["A\u0301"]), # A with combining acute accent
+        ("🇺🇸", ["🇺🇸"]),
+        ("👋🏾", ["👋🏾"]), # Wave with skin tone
+    ]
+    for text, expected in test_cases:
+        result = list(graphemes(text))
+        assert result == expected, f"Failed for {text!r}: expected {expected!r}, got {result!r}"
+    print("graphemes() passed!")
+
+def test_set_cell_size():
+    print("Testing set_cell_size()...")
+    # 👨‍👩‍👧‍👦 is 2 cells
+    text = "👨‍👩‍👧‍👦"
+    result = set_cell_size(text, 1)
+    assert result == " ", f"Should pad with space if first grapheme is too large. Got {result!r}"
+    
+    text = "👨‍👩‍👧‍👦hello" # 2 + 5 = 7 cells
+    result = set_cell_size(text, 3)
+    assert result == "👨‍👩‍👧‍👦h", f"Should fit 👨‍👩‍👧‍👦 (2) and 'h' (1). Got {result!r}"
+    
+    result = set_cell_size("👨‍👩‍👧‍👦", 3)
+    assert result == "👨‍👩‍👧‍👦 ", f"Should pad with space. Got {result!r}"
+    print("set_cell_size() passed!")
+
+def test_chop_cells():
+    print("Testing chop_cells()...")
+    # 👨‍👩‍👧‍👦 is 2 cells.
+    result = chop_cells(["👨‍👩‍👧‍👦"], 1)
+    assert result == [" "], f"Should replace 👨‍👩‍👧‍👦 with space if it doesn't fit. Got {result!r}"
+    result = chop_cells(["👨‍👩‍👧‍👦"], 2)
+    assert result == ["👨‍👩‍👧‍👦"], f"Should keep 👨‍👩‍👧‍👦 if it fits. Got {result!r}"
+    print("chop_cells() passed!")
+
+def test_text_right_crop():
+    print("Testing Text.right_crop()...")
+    t = Text("👨‍👩‍👧‍👦hello") # 👨‍👩‍👧‍👦 is 1 grapheme, h,e,l,l,o are 5. Total 6 graphemes.
+    t.right_crop(1) # remove 'o'
+    assert t.plain == "👨‍👩‍👧‍👦hell", f"Expected 👨‍👩‍👧‍👦hell, got {t.plain!r}"
+    t.right_crop(4) # remove 'h','e','l','l'
+    assert t.plain == "👨‍👩‍👧‍👦", f"Expected 👨‍👩‍👧‍👦, got {t.plain!r}"
+    t.right_crop(1) # remove 👨‍👩‍👧‍👦
+    assert t.plain == "", f"Expected empty, got {t.plain!r}"
+    print("Text.right_crop() passed!")
+
+if __name__ == "__main__":
+    try:
+        test_graphemes()
+        test_set_cell_size()
+        test_chop_cells()
+        test_text_right_crop()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
