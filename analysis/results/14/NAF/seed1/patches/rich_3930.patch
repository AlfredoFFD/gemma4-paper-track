+def graphemes(text: str) -> Iterable[str]:
+    """Yields each grapheme from the text.
+
+    Args:
+        text: The text to split into graphemes.
+
+    Returns:
+        An iterable of graphemes.
+    """
+    if not text:
+        return
+
+    import unicodedata
+
+    chars = list(text)
+    i = 0
+    while i < len(chars):
+        char = chars[i]
+        grapheme = [char]
+        i += 1
+
+        while i < len(chars):
+            if grapheme[-1] == "\u200d":
+                grapheme.append(chars[i])
+                i += 1
+                continue
+
+            next_char = chars[i]
+            if len(grapheme) == 1 and "\U0001f1e6" <= grapheme[0] <= "\U0001f1ff" and "\U0001f1e6" <= next_char <= "\U0001f1ff":
+                grapheme.append(next_char)
+                i += 1
+                continue
+
+            if (
+                unicodedata.combining(next_char)
+                or next_char == "\u200d"
+                or "\U0001f3fb" <= next_char <= "\U0001f3ff"
+            ):
+                grapheme.append(next_char)
+                i += 1
+                continue
+
+            break
+
+        yield "".join(grapheme)
+
