index 00000000..8f02184b
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,32 @@
+from rich.text import Text
+from rich.console import Console
+
+def test_expand_tabs_style():
+    console = Console(force_terminal=True)
+    
+    # Create text with a styled tab
+    text = Text("Hello\tWorld")
+    text.stylize("red", 0, 6) # "Hello\t" is red
+    
+    print("Original text spans:", text._spans)
+    
+    text.expand_tabs(tab_size=8)
+    
+    print("Expanded text spans:", text._spans)
+    
+    # The tab was at index 5.
+    # "Hello" is 5 chars. Tab is 1 char.
+    # Tab should expand to 8 - 5 = 3 spaces.
+    # So "Hello   " should be red.
+    # Total length should be 5 + 3 + 5 = 13.
+    # The red span should be from 0 to 8.
+    
+    # Let's check the spans.
+    for span in text._spans:
+        print(f"Span: {span}")
+
+    # We can also just print it to see.
+    console.print(text)
+
+if __name__ == "__main__":
+    test_expand_tabs_style()
