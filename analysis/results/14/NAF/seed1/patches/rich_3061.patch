+from rich.text import Text
+from rich.console import Console
+
+def test_expand_tabs_different_styles():
+    console = Console(force_terminal=True)
+    
+    # Base style is blue
+    text = Text("Hello\tWorld", style="blue")
+    # Tab is red
+    text.stylize("red", 5, 6) 
+    
+    print("Original text spans:", text._spans)
+    text.expand_tabs(tab_size=8)
+    print("Expanded text spans:", text._spans)
+    console.print(text)
+
+if __name__ == "__main__":
+    test_expand_tabs_different_styles()
