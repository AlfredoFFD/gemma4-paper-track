+def get_callable_globals(call: Any) -> Dict[str, Any]:
+    unwrapped = call
+    while hasattr(unwrapped, "func"):
+        unwrapped = unwrapped.func
+    unwrapped = inspect.unwrap(unwrapped)
+    if hasattr(unwrapped, "__globals__"):
+        return unwrapped.__globals__
+    if inspect.isclass(unwrapped):
+        init_method = getattr(unwrapped, "__init__", None)
+        if init_method:
+            return getattr(inspect.unwrap(init_method), "__globals__", {})
+        new_method = getattr(unwrapped, "__new__", None)
+        if new_method:
+            return getattr(inspect.unwrap(new_method), "__globals__", {})
+    if hasattr(unwrapped, "__call__"):
+        call_method = getattr(unwrapped, "__call__")
+        return getattr(inspect.unwrap(call_method), "__globals__", {})
+    return {}
+
