@@ -0,0 +1,24 @@
+from rich.console import Console, ConsoleOptions
+from rich.padding import Padding
+from rich.console import ConsoleDimensions
+from rich.text import Text
+
+# Console width = 2
+options = ConsoleOptions(
+    size=ConsoleDimensions(width=2, height=24),
+    legacy_windows=False,
+    min_width=1,
+    max_width=2,
+    is_terminal=True,
+    encoding="utf-8",
+    max_height=24
+)
+
+console = Console()
+# Padding left=2, right=2. Total extra_width = 4.
+# Console width = 2.
+padding = Padding(Text("Hello"), (0, 2, 0, 2), expand=True)
+
+print("Rendering padding...")
+for segment in padding.__rich_console__(console, options):
+    print(f"Segment: {segment}")
