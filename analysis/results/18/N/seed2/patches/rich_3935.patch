diff --git a/reproduce_issue_3.py b/reproduce_issue_3.py
new file mode 100644
index 00000000..74a7567b
--- /dev/null
+++ b/reproduce_issue_3.py
@@ -0,0 +1,26 @@
+from rich.console import Console, ConsoleOptions
+from rich.padding import Padding
+from rich.console import ConsoleDimensions
+
+# Mock ConsoleOptions with max_width=None
+options = ConsoleOptions(
+    size=ConsoleDimensions(width=80, height=24),
+    legacy_windows=False,
+    min_width=1,
+    max_width=None, # This should be int according to type hint
+    is_terminal=True,
+    encoding="utf-8",
+    max_height=24
+)
+
+console = Console()
+try:
+    # This will call __rich_console__ with our options
+    # We can't easily pass options to console.print, but we can call __rich_console__ directly
+    padding = Padding("Hello", (1, 1, 1, 1), expand=True)
+    for segment in padding.__rich_console__(console, options):
+        print(segment)
+except Exception as e:
+    print(f"Caught exception: {e}")
+    import traceback
+    traceback.print_exc()
diff --git a/reproduce_issue_4.py b/reproduce_issue_4.py
