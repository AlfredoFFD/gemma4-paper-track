+from rich.text import Text
+
+def test_expand_tabs_style():
+    # Base style is white
+    text = Text("Hello\tWorld", style="white")
+    # Stylize "Hello\t" as red. The tab is at index 5.
+    text.stylize("red", 0, 6)
+    
+    # Expand tabs
+    text.expand_tabs(tab_size=8)
+    
+    # "Hello" is 5 chars. Tab is at index 5.
+    # Tab should expand to 3 spaces to reach 8.
+    # So indices 5, 6, 7 should be red.
+    # "World" starts at index 8.
+    
+    # Let's check the spans.
+    spans = text.spans
+    print(f"Text: {repr(text.plain)}")
+    print(f"Spans: {spans}")
+    
+    # Expected: a span from 0 to 8 with style 'red'
+    # (5 for "Hello" + 3 for expanded tab)
+    # And the rest is 'white' (or no span if it's the base style)
+    
+    found_red_tab = False
+    for span in spans:
+        if span.style == "red":
+            if span.start == 0 and span.end == 8:
+                found_red_tab = True
+                break
+    
+    if found_red_tab:
+        print("SUCCESS: Tab style preserved")
+    else:
+        print("FAILURE: Tab style lost")
+
+if __name__ == "__main__":
+    test_expand_tabs_style()
