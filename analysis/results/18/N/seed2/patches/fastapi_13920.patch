diff --git a/verify_pep695.py b/verify_pep695.py
new file mode 100644
index 00000000..29badcd6
--- /dev/null
+++ b/verify_pep695.py
@@ -0,0 +1,56 @@
+
+import typing
+import typing_extensions
+from fastapi._compat.shared import (
+    is_bytes_or_nonable_bytes_annotation,
+    is_uploadfile_or_nonable_uploadfile_annotation,
+    annotation_is_pydantic_v1,
+    unwrap_type_alias,
+    is_typealiastype,
+)
+from fastapi import UploadFile
+try:
+    from typing import TypeAliasType
+except ImportError:
+    from typing_extensions import TypeAliasType
+
+print(f"TypeAliasType: {TypeAliasType}")
+
+# Test PEP 695 Type Alias
+# type MyBytes = bytes
+MyBytes = TypeAliasType("MyBytes", bytes)
+print(f"MyBytes: {MyBytes}, type: {type(MyBytes)}")
+print(f"is_typealiastype(MyBytes): {is_typealiastype(MyBytes)}")
+print(f"unwrap_type_alias(MyBytes): {unwrap_type_alias(MyBytes)}")
+
+print(f"Testing is_bytes_or_nonable_bytes_annotation with MyBytes: {is_bytes_or_nonable_bytes_annotation(MyBytes)}")
+
+# type MyUploadFile = UploadFile
+MyUploadFile = TypeAliasType("MyUploadFile", UploadFile)
+print(f"MyUploadFile: {MyUploadFile}, type: {type(MyUploadFile)}")
+print(f"is_typealiastype(MyUploadFile): {is_typealiastype(MyUploadFile)}")
+print(f"unwrap_type_alias(MyUploadFile): {unwrap_type_alias(MyUploadFile)}")
+print(f"Testing is_uploadfile_or_nonable_uploadfile_annotation with MyUploadFile: {is_uploadfile_or_nonable_uploadfile_annotation(MyUploadFile)}")
+
+# For annotation_is_pydantic_v1, we need a Pydantic v1 model.
+try:
+    from pydantic import BaseModel
+    class MyModel(BaseModel):
+        pass
+    
+    # type MyModelAlias = MyModel
+    MyModelAlias = TypeAliasType("MyModelAlias", MyModel)
+    print(f"MyModelAlias: {MyModelAlias}, type: {type(MyModelAlias)}")
+    print(f"is_typealiastype(MyModelAlias): {is_typealiastype(MyModelAlias)}")
+    print(f"unwrap_type_alias(MyModelAlias): {unwrap_type_alias(MyModelAlias)}")
+    print(f"Testing annotation_is_pydantic_v1 with MyModelAlias: {annotation_is_pydantic_v1(MyModelAlias)}")
+except Exception as e:
+    print(f"Pydantic test failed: {e}")
+
+# Test nested aliases
+# type NestedBytes = MyBytes
+NestedBytes = TypeAliasType("NestedBytes", MyBytes)
+print(f"NestedBytes: {NestedBytes}, type: {type(NestedBytes)}")
+print(f"is_typealiastype(NestedBytes): {is_typealiastype(NestedBytes)}")
+print(f"unwrap_type_alias(NestedBytes): {unwrap_type_alias(NestedBytes)}")
+print(f"Testing is_bytes_or_nonable_bytes_annotation with NestedBytes: {is_bytes_or_nonable_bytes_annotation(NestedBytes)}")
