+def graphemes(text: str) -> Iterable[str]:
+    """Yields each grapheme cluster from the text."""
+    if not text:
+        return
+
+    current_grapheme = ""
+    join_next = False
+    for char in text:
+        if join_next:
+            current_grapheme += char
+            join_next = False
+        elif current_grapheme and unicodedata.combining(char) > 0:
+            current_grapheme += char
+        elif char == "\u200d":
+            current_grapheme += char
+            join_next = True
+        elif current_grapheme:
+            yield current_grapheme
+            current_grapheme = char
+        else:
+            current_grapheme = char
+
+    if current_grapheme:
+        yield current_grapheme
+
+
+def get_grapheme_cell_size(grapheme: str) -> int:
+    """Get the cell size of a grapheme."""
+    return sum(get_character_cell_size(char) for char in grapheme)
+
