+++ b/reproduce_bg_multi.py
@@ -0,0 +1,11 @@
+from rich.console import Console
+from rich.text import Text
+
+console = Console(width=20, record=True)
+text = Text()
+for i in range(10):
+    text.append(" word", style="on blue")
+    text.append(" ", style="on red")
+
+console.print(text, soft_wrap=True)
+print(console.export_text(styles=True))
