diff --git a/repro_warnings.py b/repro_warnings.py
new file mode 100644
index 00000000..f3f1ac30
--- /dev/null
+++ b/repro_warnings.py
@@ -0,0 +1,70 @@
+
+import warnings
+from fastapi import FastAPI, Body, Form
+from fastapi.dependencies.utils import analyze_param
+from fastapi.routing import APIRoute, get_request_handler
+from fastapi.dependencies.models import Dependant
+from fastapi import params
+from fastapi import temp_pydantic_v1_params
+import inspect
+
+def test_analyze_param_warning():
+    print("Testing analyze_param warning...")
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        # Use temp_pydantic_v1_params.Body
+        analyze_param(
+            param_name="test",
+            annotation=None, # Not used for this test
+            value=temp_pydantic_v1_params.Body(),
+            is_path_param=False,
+        )
+        # Wait, analyze_param expects annotation to be Annotated for the logic I changed.
+        # Let's use Annotated.
+        from typing import Annotated
+        analyze_param(
+            param_name="test",
+            annotation=Annotated[int, temp_pydantic_v1_params.Body()],
+            value=None,
+            is_path_param=False,
+        )
+        
+        # Check if warning was triggered
+        found = any("Pydantic v1 is deprecated" in str(warn.message) for warn in w)
+        print(f"Warning found: {found}")
+        assert found
+
+def test_get_dependant_warning():
+    print("Testing get_dependant warning...")
+    # This is harder to trigger manually without a full setup.
+    # But we can try to mock the param_details.
+    pass
+
+def test_get_request_handler_warning():
+    print("Testing get_request_handler warning...")
+    # Mocking Dependant and body_field
+    class MockField:
+        def __init__(self, field_info):
+            self.field_info = field_info
+            
+    dependant = Dependant(call=lambda: None, name="test", path="/test", scope="function")
+    body_field = MockField(temp_pydantic_v1_params.Form())
+    
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        get_request_handler(dependant=dependant, body_field=body_field)
+        
+        found = any("Pydantic v1 is deprecated" in str(warn.message) for warn in w)
+        print(f"Warning found: {found}")
+        assert found
+
+if __name__ == "__main__":
+    try:
+        test_analyze_param_warning()
+        test_get_request_handler_warning()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
