diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..6b6454ed
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,45 @@
+from typing import Annotated, Any
+try:
+    from types import TypeAliasType
+except ImportError:
+    from typing import TypeAliasType
+from fastapi.dependencies.utils import analyze_param
+import inspect
+from pydantic import Field
+
+# Define a type alias using PEP 695
+MyAlias = TypeAliasType("MyAlias", int)
+
+def test_type_alias():
+    # Case 1: Simple TypeAliasType
+    details = analyze_param(
+        param_name="p1",
+        annotation=MyAlias,
+        value=inspect.Signature.empty,
+        is_path_param=False,
+    )
+    print(f"Case 1: {details.type_annotation} == int: {details.type_annotation is int}")
+
+    # Case 2: Annotated[TypeAliasType, ...]
+    AnnotatedAlias = Annotated[MyAlias, Field(description="test")]
+    details = analyze_param(
+        param_name="p2",
+        annotation=AnnotatedAlias,
+        value=inspect.Signature.empty,
+        is_path_param=False,
+    )
+    print(f"Case 2: {details.type_annotation} == int: {details.type_annotation is int}")
+
+    # Case 3: Nested TypeAliasType
+    Alias1 = TypeAliasType("Alias1", int)
+    Alias2 = TypeAliasType("Alias2", Alias1)
+    details = analyze_param(
+        param_name="p3",
+        annotation=Alias2,
+        value=inspect.Signature.empty,
+        is_path_param=False,
+    )
+    print(f"Case 3: {details.type_annotation} == int: {details.type_annotation is int}")
+
+if __name__ == "__main__":
+    test_type_alias()
