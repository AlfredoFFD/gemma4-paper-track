+def iter_graphemes(text: str) -> Iterator[str]:
+    """Iterate over the grapheme clusters in a string."""
+    if not text:
+        return
+
+    grapheme = ""
+    for char in text:
+        width = get_character_cell_size(char)
+        if width == 0:
+            grapheme += char
+        else:
