+def get_endpoint_context(dependant: Dependant, methods: Union[str, Set[str]], path: str) -> str:
+    try:
+        file = inspect.getfile(dependant.call)
+        line = inspect.getlineno(dependant.call)
+        name = dependant.call.__name__
+        if isinstance(methods, set):
+            method_str = ", ".join(sorted(methods))
+        else:
+            method_str = methods
+        return f'File "{file}", line {line}, in {name}\n    {method_str} {path}'
+    except Exception:
+        return ""
