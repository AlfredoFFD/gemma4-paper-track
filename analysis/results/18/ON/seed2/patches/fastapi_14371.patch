+++ b/reproduce_issue.py
@@ -0,0 +1,45 @@
+from fastapi import FastAPI, Query, Body, Depends
+from pydantic import BaseModel, Field
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/query")
+async def read_query(q: str = Query(..., validation_alias="query_alias")):
+    return {"q": q}
+
+class BodyModel(BaseModel):
+    name: str = Field(..., validation_alias="name_alias")
+
+@app.post("/body")
+async def read_body(body: BodyModel = Body()):
+    return {"name": body.name}
+
+client = TestClient(app)
+
+def test_query_alias():
+    print("Testing query alias...")
+    response = client.get("/query", params={"query_alias": "hello"})
+    print(f"Response status: {response.status_code}")
+    print(f"Response json: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"q": "hello"}
+
+def test_body_alias():
+    print("Testing body alias...")
+    response = client.post("/body", json={"name_alias": "world"})
+    print(f"Response status: {response.status_code}")
+    print(f"Response json: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"name": "world"}
+
+if __name__ == "__main__":
+    try:
+        test_query_alias()
+        test_body_alias()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
