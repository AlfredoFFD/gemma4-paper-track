@@ -0,0 +1,16 @@
+from fastapi import FastAPI, UploadFile
+from pydantic import BaseModel
+import json
+
+app = FastAPI()
+
+class Item(BaseModel):
+    data: bytes
+    file: UploadFile
+
+@app.post("/upload")
+async def upload(item: Item):
+    return {"status": "ok"}
+
+openapi_schema = app.openapi()
+print(json.dumps(openapi_schema, indent=2))
