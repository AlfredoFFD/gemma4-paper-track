+def get_graphemes(text: str) -> list[str]:
+    """Split text into graphemes."""
+    graphemes = []
+    if not text:
+        return graphemes
+
+    chars = list(text)
+    i = 0
+    while i < len(chars):
+        start = i
+        i += 1
+        while i < len(chars) and (get_character_cell_size(chars[i]) == 0 or chars[i-1] == "\u200d"):
+            i += 1
+        graphemes.append("".join(chars[start:i]))
+    return graphemes
+
