index 00000000..b1e20c8a
--- /dev/null
+++ b/reproduce_bug.py
@@ -0,0 +1,21 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.openapi.utils import get_openapi
+
+app = FastAPI(dependencies=[Depends(OAuth2PasswordBearer(tokenUrl="token"))])
+
+@app.get("/")
+def root():
+    return {"message": "Hello World"}
+
+openapi_schema = get_openapi(app, app.title, app.version, app.description, app.routes)
+print(openapi_schema)
+
+# Verify that security requirements are present for the root endpoint
+root_endpoint = next(route for route in app.routes if route.path == "/")
+security = openapi_schema["paths"]["/"]["get"]["security"]
+print(f"Security for root: {security}")
+
+assert security is not None
+assert len(security) > 0
+print("Verification successful!")
