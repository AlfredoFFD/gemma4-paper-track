--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,26 @@
+from fastapi import FastAPI, Depends
+from fastapi.security import OAuth2PasswordBearer
+
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def test_security_top_level():
+    app = FastAPI(dependencies=[Depends(oauth2_scheme)])
+    
+    @app.get("/")
+    async def root():
+        return {"message": "Hello World"}
+    
+    openapi_schema = app.openapi()
+    paths = openapi_schema["paths"]
+    root_path = paths["/"]["get"]
+    
+    security = root_path.get("security")
+    print(f"Security requirements for root: {security}")
+    
+    if security is None:
+        print("FAILED: Security requirements not found in OpenAPI schema")
+    else:
+        print("PASSED: Security requirements found in OpenAPI schema")
+
+if __name__ == "__main__":
+    test_security_top_level()
