new file mode 100644
index 00000000..b6bc0df9
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,14 @@
+from rich.markup import escape, render
+from rich.text import Text
+
+def test_escape_trailing_backslash():
+    user_input = "Hello \\"
+    markup = f"Result: {escape(user_input)}[bold]World[/bold]"
+    # Expected: Result: Hello \ [bold]World[/bold]
+    # Actual: Result: Hello \[bold]World[/bold] -> Result: Hello [bold]World[/bold]
+    rendered = render(markup)
+    print(f"Rendered: {rendered}")
+    assert rendered.plain == "Result: Hello \\[bold]World[/bold]" # This is what it currently does probably
+
+if __name__ == "__main__":
+    test_escape_trailing_backslash()
