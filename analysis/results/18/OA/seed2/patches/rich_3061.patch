+from rich.text import Text
+from rich.style import Style
+
+def test_expand_tabs_style():
+    # Create a Text object with a styled tab
+    text = Text("Hello\tWorld", style="white")
+    text._spans.append((5, 6, "red")) # Tab is at index 5
+    
+    print(f"Before expand_tabs: {text.plain}")
+    text.expand_tabs(tab_size=8)
+    print(f"After expand_tabs: {text.plain}")
+    
+    # Tab was at index 5. Tab size 8 means it should expand to 3 spaces (indices 5, 6, 7).
+    # All these should be red.
+    
+    # Let's check the spans.
+    # We expect that for each index in [5, 6, 7], the last span covering it is red.
+    
+    all_red = True
+    for i in range(5, 8):
+        last_style = "white" # base style
+        for start, end, style in text._spans:
+            if start <= i < end:
+                last_style = style
+        print(f"Index {i}: last_style={last_style}")
+        if str(last_style) != "red":
+            all_red = False
+            
+    if all_red:
+        print("SUCCESS: Tab style preserved!")
+    else:
+        print("FAILURE: Tab style not preserved!")
+
+if __name__ == "__main__":
+    test_expand_tabs_style()
