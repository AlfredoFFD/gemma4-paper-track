+from rich.markup import escape, render
+from rich.text import Text
+
+def test_trailing_backslash():
+    text = "Hello \\"
+    escaped = escape(text)
+    print(f"Original: {text!r}")
+    print(f"Escaped: {escaped!r}")
+    
+    # If we append a tag to the escaped text, it should not be escaped
+    markup = escaped + "[red]World[/red]"
+    print(f"Markup: {markup!r}")
+    
+    rendered = render(markup)
+    print(f"Rendered: {rendered}")
+    # The rendered text should have "Hello \ [red]World[/red]" where [red]World[/red] is red.
+    # But if escaped is "Hello \", then markup is "Hello \[red]World[/red]", and [red] is escaped.
+    
+    # We expect the rendered text to have the style 'red' for 'World'
+    # Let's check the spans.
+    print(f"Spans: {rendered.spans}")
+
+if __name__ == "__main__":
+    test_trailing_backslash()
