+import io
+from rich.console import Console
+from rich.table import Table, Column
+
+def test_padding_width():
+    # Case 1: pad_edge=False
+    console = Console(file=io.StringIO(), force_terminal=True, width=100)
+    table = Table(
+        padding=(0, 1, 0, 1),
+        pad_edge=False,
+        show_header=False,
+        show_edge=True,
+    )
+    table.add_column("Col 1")
+    table.add_column("Col 2")
+
+    table.add_row("Col 1", "Col 2")
+    
+    console.print(table)
+    output = console.file.getvalue()
+    
+    # Expected output: ┃Col 1┃Col 2┃
+    # Col 1: width 5. Padding: left=0, right=1. Total width = 6.
+    # Col 2: width 5. Padding: left=1, right=0. Total width = 6.
+    # Total line: ┃ + 6 + ┃ + 6 + ┃ = 15 chars.
+    # Wait, the vertical border is shared.
+    # ┃Col 1 ┃Col 2┃
+    # 1 + 6 + 1 + 5 + 1 = 14? No.
+    # Col 1: ┃Col 1 ┃ (1 + 6 + 1)
+    # Col 2: Col 2┃ (5 + 1)
+    # Total: ┃Col 1 ┃Col 2┃
+    # Let's count: ┃(1) C(2) o(3) l(4) (5) 1(6) (7) ┃(8) C(9) o(10) l(11) (12) 2(13) ┃(14)
+    # Wait, if pad_edge=False, then Col 1 has right=1, Col 2 has left=1.
+    # So Col 1 is "Col 1 " (6 chars) and Col 2 is " Col 2" (6 chars).
+    # ┃Col 1 ┃ Col 2┃
+    # 1 + 6 + 1 + 6 + 1 = 15 chars.
+    
+    # Let's see what we get.
+    print(f"Output: {repr(output)}")
+    print(f"Length: {len(output.strip())}")
+
+if __name__ == "__main__":
+    test_padding_width()
