@@ -0,0 +1,27 @@
+from fastapi import FastAPI, Body
+from pydantic import BaseModel, Field
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post("/item/")
+async def create_item(item_name: str = Body(serialization_alias="item_name_alias")):
+    return {"item_name": item_name}
+
+client = TestClient(app)
+
+def test_openapi_body_serialization_alias():
+    response = client.get("/openapi.json")
+    assert response.status_code == 200
+    schema = response.json()
+    assert "item_name_alias" in str(schema)
+
+if __name__ == "__main__":
+    try:
+        test_openapi_body_serialization_alias()
+        print("test_openapi_body_serialization_alias passed")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
