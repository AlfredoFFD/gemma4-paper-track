+
+app = FastAPI(dependencies=[Security(oauth2_scheme)])
+
+@app.get("/")
+async def read_root():
+    return {"Hello": "World"}
+
+client = TestClient(app)
+
+def test_openapi_security():
+    response = client.get("/openapi.json")
+    assert response.status_code == 200
+    openapi_schema = response.json()
+    
+    print("OpenAPI Schema components:", json.dumps(openapi_schema.get("components", {}), indent=2))
+    
+    paths = openapi_schema.get("paths", {})
+    print("Paths:", json.dumps(paths, indent=2))
+    
+    assert "components" in openapi_schema
+    assert "securitySchemes" in openapi_schema["components"]
+    
+    assert "/" in paths
+    assert "get" in paths["/"]
+    assert "security" in paths["/"]["get"]
+
+if __name__ == "__main__":
+    try:
+        test_openapi_security()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
