+from rich.text import Text
+
+def test_expand_tabs_style():
+    # Create text with a tab that has a specific style
+    text = Text("Hello\tWorld", style="red")
+    
+    print(f"Before expand_tabs: {text}")
+    text.expand_tabs(8)
+    print(f"After expand_tabs: {text}")
+    
+    for i in range(len(text)):
+        print(f"Char {i}: {text[i].plain} - Style: {repr(text[i].style)}")
+
+if __name__ == "__main__":
+    test_expand_tabs_style()
