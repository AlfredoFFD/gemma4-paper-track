+from fastapi import FastAPI, Depends, Security
+from fastapi.dependencies.utils import get_dependant
+from fastapi.security.oauth2 import OAuth2
+
+# Mock OAuth2 for simplicity
+class MockOAuth2(OAuth2):
+    def __init__(self):
+        super().__init__()
+
+oauth2 = MockOAuth2()
+
+def dep1_sec(token: str = Security(oauth2, scopes=["scope1"])):
+    return token
+
+def dep2_sec(token: str = Security(oauth2, scopes=["scope2"])):
+    return token
+
+def root_dep_sec(a=Depends(dep1_sec), b=Depends(dep2_sec)):
+    pass
+
+# Now let's use get_dependant to analyze root_dep_sec
+dependant = get_dependant(
+    path="/test",
+    call=root_dep_sec,
+    security_scopes=["root_scope"]
+)
+
+print(f"Root scopes: {dependant.security_scopes}")
+for dep in dependant.dependencies:
+    print(f"Dep {dep.name} scopes: {dep.security_scopes}")
+
+# Expected:
+# Root scopes: ['root_scope']
+# Dep a scopes: ['root_scope', 'scope1']
+# Dep b scopes: ['root_scope', 'scope2']
+
+# Actual if bug exists:
+# Root scopes: ['root_scope', 'scope1', 'scope2']
+# Dep a scopes: ['root_scope', 'scope1']
+# Dep b scopes: ['root_scope', 'scope1', 'scope2']
+# (or something similar)
