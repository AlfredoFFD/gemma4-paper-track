+def get_endpoint_context(dependant: Dependant, route: Any) -> str:
+    call = dependant.call
+    if call is None:
+        return ""
+    try:
+        file = inspect.getfile(call)
+        file = os.path.abspath(file)
+        try:
+            line = inspect.getsourcelines(call)[1]
+        except (OSError, TypeError):
+            line = "unknown"
+        name = call.__name__
+        path = getattr(route, "path", "unknown")
+        methods = getattr(route, "methods", None)
+        if methods:
+            method_str = ", ".join(sorted(methods))
+        else:
+            method_str = "WS"
+        return f"endpoint={name} file={file}:{line} method={method_str} path={path}"
+    except Exception:
+        return ""
+
