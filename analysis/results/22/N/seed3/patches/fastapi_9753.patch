diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..a109c1c8
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,73 @@
+
+import functools
+from fastapi import FastAPI, Depends
+from fastapi.dependencies.models import Dependant
+from fastapi.dependencies.utils import get_dependant
+import inspect
+
+def test_partial_gen():
+    def gen_dep():
+        yield "ok"
+    
+    partial_gen = functools.partial(gen_dep)
+    dependant = get_dependant(path="/test", call=partial_gen)
+    print(f"is_gen_callable: {dependant.is_gen_callable}")
+    assert dependant.is_gen_callable is True
+
+async def test_partial_async_gen():
+    async def async_gen_dep():
+        yield "ok"
+    
+    partial_async_gen = functools.partial(async_gen_dep)
+    dependant = get_dependant(path="/test", call=partial_async_gen)
+    print(f"is_async_gen_callable: {dependant.is_async_gen_callable}")
+    assert dependant.is_async_gen_callable is True
+
+async def test_partial_coroutine():
+    async def coroutine_dep():
+        return "ok"
+    
+    partial_coroutine = functools.partial(coroutine_dep)
+    dependant = get_dependant(path="/test", call=partial_coroutine)
+    print(f"is_coroutine_callable: {dependant.is_coroutine_callable}")
+    assert dependant.is_coroutine_callable is True
+
+class CallableClass:
+    def __call__(self):
+        return "ok"
+
+def test_partial_callable_class():
+    cc = CallableClass()
+    partial_cc = functools.partial(cc)
+    dependant = get_dependant(path="/test", call=partial_cc)
+    print(f"is_coroutine_callable: {dependant.is_coroutine_callable}")
+    # CallableClass is not a coroutine, so this should be False
+    assert dependant.is_coroutine_callable is False
+
+if __name__ == "__main__":
+    try:
+        test_partial_gen()
+        print("test_partial_gen passed")
+    except Exception as e:
+        print(f"test_partial_gen failed: {e}")
+
+    try:
+        # We need to run async tests with an event loop
+        import asyncio
+        asyncio.run(test_partial_async_gen())
+        print("test_partial_async_gen passed")
+    except Exception as e:
+        print(f"test_partial_async_gen failed: {e}")
+
+    try:
+        import asyncio
+        asyncio.run(test_partial_coroutine())
+        print("test_partial_coroutine passed")
+    except Exception as e:
+        print(f"test_partial_coroutine failed: {e}")
+
+    try:
+        test_partial_callable_class()
+        print("test_partial_callable_class passed")
+    except Exception as e:
+        print(f"test_partial_callable_class failed: {e}")
