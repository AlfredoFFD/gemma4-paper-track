@@ -0,0 +1,22 @@
+
+import functools
+import asyncio
+import inspect
+from fastapi.dependencies.models import Dependant
+
+async def coroutine_dep():
+    return "ok"
+
+def test_partial_coroutine():
+    partial_coroutine = functools.partial(coroutine_dep)
+    dependant = Dependant(call=partial_coroutine)
+    print(f"unwrapped_call: {dependant._unwrapped_call}")
+    print(f"is_coroutine_callable: {dependant.is_coroutine_callable}")
+    assert dependant.is_coroutine_callable is True
+
+if __name__ == "__main__":
+    try:
+        test_partial_coroutine()
+        print("test_partial_coroutine passed")
+    except Exception as e:
+        print(f"test_partial_coroutine failed: {e}")
