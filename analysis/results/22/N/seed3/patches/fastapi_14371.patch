+from pydantic import create_model, Field
+from pydantic.fields import FieldInfo
+from typing import List
+
+class Body(FieldInfo):
+    def __init__(self, *args, **kwargs):
+        super().__init__(**kwargs)
+
+field_info = Body(alias="p_alias")
+model = create_model("BodyModel", p=(List[str], field_info))
+print(f"Field alias: {model.model_fields['p'].alias}")
+print(f"Validation alias: {model.model_fields['p'].validation_alias}")
