diff --git a/verify_security.py b/verify_security.py
new file mode 100644
index 00000000..5e9c4437
--- /dev/null
+++ b/verify_security.py
@@ -0,0 +1,73 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import APIKeyQuery, APIKeyHeader, APIKeyCookie, HTTPBearer, HTTPDigest, OpenIdConnect
+from fastapi.testclient import TestClient
+from starlette.status import HTTP_401_UNAUTHORIZED, HTTP_403_FORBIDDEN
+
+app = FastAPI()
+
+# API Key Query
+api_key_query = APIKeyQuery(name="query_key")
+@app.get("/query")
+async def query(key: str = Depends(api_key_query)):
+    return {"key": key}
+
+# API Key Header
+api_key_header = APIKeyHeader(name="header_key")
+@app.get("/header")
+async def header(key: str = Depends(api_key_header)):
+    return {"key": key}
+
+# API Key Cookie
+api_key_cookie = APIKeyCookie(name="cookie_key")
+@app.get("/cookie")
+async def cookie(key: str = Depends(api_key_cookie)):
+    return {"key": key}
+
+# HTTP Bearer
+http_bearer = HTTPBearer()
+@app.get("/bearer")
+async def bearer(token: str = Depends(http_bearer)):
+    return {"token": token}
+
+# HTTP Digest
+http_digest = HTTPDigest()
+@app.get("/digest")
+async def digest(credentials: str = Depends(http_digest)):
+    return {"credentials": credentials}
+
+# OpenID Connect
+oidc = OpenIdConnect(openIdConnectUrl="https://example.com")
+@app.get("/oidc")
+async def oidc_route(token: str = Depends(oidc)):
+    return {"token": token}
+
+# Backward compatibility test
+api_key_query_403 = APIKeyQuery(name="query_key_403", not_authenticated_status_code=HTTP_403_FORBIDDEN)
+@app.get("/query_403")
+async def query_403(key: str = Depends(api_key_query_403)):
+    return {"key": key}
+
+client = TestClient(app)
+
+def test_status_and_header(path, expected_status, expected_header_val=None):
+    response = client.get(path)
+    print(f"Path: {path}, Status: {response.status_code}, Header: {response.headers.get('WWW-Authenticate')}")
+    assert response.status_code == expected_status
+    if expected_header_val:
+        assert response.headers.get('WWW-Authenticate') == expected_header_val
+    else:
+        assert response.headers.get('WWW-Authenticate') is None
+
+try:
+    test_status_and_header("/query", HTTP_401_UNAUTHORIZED, 'ApiKey in="query", name="query_key"')
+    test_status_and_header("/header", HTTP_401_UNAUTHORIZED, 'ApiKey in="header", name="header_key"')
+    test_status_and_header("/cookie", HTTP_401_UNAUTHORIZED, 'ApiKey in="cookie", name="cookie_key"')
+    test_status_and_header("/bearer", HTTP_401_UNAUTHORIZED, 'Bearer')
+    test_status_and_header("/digest", HTTP_401_UNAUTHORIZED, 'Digest')
+    test_status_and_header("/oidc", HTTP_401_UNAUTHORIZED, 'Bearer')
+    test_status_and_header("/query_403", HTTP_403_FORBIDDEN)
+    print("All tests passed!")
+except AssertionError as e:
+    print(f"Test failed: {e}")
+except Exception as e:
+    print(f"An error occurred: {e}")
