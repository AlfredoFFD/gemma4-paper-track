index 00000000..3066e3f6
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,46 @@
+from fastapi._compat import shared
+from typing import Union, List, Optional
+import types
+
+def test_sequence():
+    # Test list[int] | None (Python 3.10+ syntax)
+    # We use eval to avoid SyntaxError on older Python versions if any
+    try:
+        ann = eval("list[int] | None")
+    except SyntaxError:
+        ann = Optional[List[int]]
+    
+    print(f"list[int] | None: {shared.field_annotation_is_sequence(ann)}")
+    print(f"list[int] | None (scalar_sequence): {shared.field_annotation_is_scalar_sequence(ann)}")
+
+    # Test list[int]
+    ann = List[int]
+    print(f"List[int]: {shared.field_annotation_is_sequence(ann)}")
+    print(f"List[int] (scalar_sequence): {shared.field_annotation_is_scalar_sequence(ann)}")
+
+    # Test str | None
+    try:
+        ann = eval("str | None")
+    except SyntaxError:
+        ann = Optional[str]
+    print(f"str | None: {shared.field_annotation_is_sequence(ann)}")
+    print(f"str | None (scalar_sequence): {shared.field_annotation_is_scalar_sequence(ann)}")
+
+    # Test list[str] | None
+    try:
+        ann = eval("list[str] | None")
+    except SyntaxError:
+        ann = Optional[List[str]]
+    print(f"list[str] | None: {shared.field_annotation_is_sequence(ann)}")
+    print(f"list[str] | None (scalar_sequence): {shared.field_annotation_is_scalar_sequence(ann)}")
+
+    # Test list[list[int]] | None
+    try:
+        ann = eval("list[list[int]] | None")
+    except SyntaxError:
+        ann = Optional[List[List[int]]]
+    print(f"list[list[int]] | None: {shared.field_annotation_is_sequence(ann)}")
+    print(f"list[list[int]] | None (scalar_sequence): {shared.field_annotation_is_scalar_sequence(ann)}")
+
+if __name__ == "__main__":
+    test_sequence()
