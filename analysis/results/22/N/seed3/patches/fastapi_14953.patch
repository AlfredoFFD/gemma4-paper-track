@@ -278,10 +278,26 @@ def get_definitions(
         for field in list(fields) + list(unique_flat_model_fields)
     ]
     field_mapping, definitions = schema_generator.generate_definitions(inputs=inputs)
+
+    def replace_binary_format(schema: Any) -> None:
+        if isinstance(schema, dict):
+            if schema.get("type") == "string" and schema.get("format") == "binary":
+                schema.pop("format", None)
+                schema["contentMediaType"] = "application/octet-stream"
+            for value in schema.values():
+                replace_binary_format(value)
+        elif isinstance(schema, list):
+            for item in schema:
+                replace_binary_format(item)
+
+    for schema in field_mapping.values():
+        replace_binary_format(schema)
+
     for item_def in cast(dict[str, dict[str, Any]], definitions).values():
         if "description" in item_def:
             item_description = cast(str, item_def["description"]).split("\f")[0]
             item_def["description"] = item_description
+        replace_binary_format(item_def)
