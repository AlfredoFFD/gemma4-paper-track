@@ -0,0 +1,43 @@
+from fastapi import FastAPI, File, UploadFile
+from fastapi.openapi.utils import get_openapi
+from fastapi.routing import APIRoute
+from pydantic import BaseModel
+
+app = FastAPI()
+
+class Item(BaseModel):
+    file: bytes
+    upload_file: UploadFile
+
+@app.post("/upload")
+async def upload(item: Item):
+    return {"status": "ok"}
+
+# Mocking the routes for get_openapi
+routes = [
+    # We need to simulate how APIRoute is used in get_openapi
+    # For simplicity, let's just use the app's routes
+]
+for route in app.routes:
+    routes.append(route)
+
+openapi_schema = get_openapi(
+    title="Test API",
+    version="1.0.0",
+    routes=routes,
+)
+
+import json
+print(json.dumps(openapi_schema, indent=2))
+
+# Check if "format": "binary" exists
+schema_str = json.dumps(openapi_schema)
+if '"format": "binary"' in schema_str:
+    print("FAILURE: 'format': 'binary' still exists in schema")
+    exit(1)
+elif '"contentMediaType": "application/octet-stream"' in schema_str:
+    print("SUCCESS: 'contentMediaType': 'application/octet-stream' found")
+    exit(0)
+else:
+    print("FAILURE: 'contentMediaType' not found")
+    exit(1)
