{
  "columns": ["Evidence", "Built", "Analyzed", "Left out"],
  "widths": [0.17, 0.33, 0.27, 0.23],
  "note": "Every number is read from the stored report of its analysis (analysis/results).",
  "values": {
    "states": {"file": "analysis/results/rederive_s5.txt", "pattern": "states in states\\.jsonl: (\\d+)"},
    "runs": {"file": "analysis/results/rederive_s5.txt", "pattern": "distinct \\(task, run\\): all states (\\d+)"},
    "tasks": {"file": "analysis/results/rederive_s5.txt", "pattern": "distinct tasks: all states (\\d+)"},
    "seeds": {"file": "analysis/results/rederive_s5.txt", "pattern": "states in states\\.jsonl: \\d+; seeds: (\\[[^\\]]*\\])", "count": true},
    "c_first": {"file": "analysis/results/rederive_s5.txt", "pattern": "complete states \\(all 30 \\(arm,seed\\) replays valid\\): (\\d+)"},
    "c_names": {"file": "analysis/results/analyze_a.txt", "pattern": "states with every arm and seed present: (\\d+)"},
    "c_platform": {"file": "analysis/results/c/analyze_c.txt", "pattern": "states complete across all arms and seeds: (\\d+)"},
    "c_channel": {"file": "analysis/results/d1/analyze_d1.txt", "pattern": "^complete states \\(every arm x seeds 1-3 usable\\): (\\d+) of"},
    "c_rendering": {"file": "analysis/results/w/analyze_w.txt", "pattern": "^complete states: (\\d+) of"},
    "c_current": {"file": "analysis/results/g/analyze_g.txt", "pattern": "PART \"one step\"(?:.*\\n)*?\\s+complete states: (\\d+) of"},
    "c_parts": {"file": "analysis/results/12/analyze_12.txt", "pattern": "complete states \\(H, EL and EPATH usable for seeds 1 to 3\\): (\\d+) of"},
    "c_hits": {"file": "analysis/results/13/analyze_13.txt", "pattern": "complete states \\(E and EG usable for seeds 1 to 3\\): (\\d+) of", "optional": true},
    "c_min": {"min": ["c_first", "c_names", "c_platform", "c_channel", "c_rendering", "c_current", "c_parts", "c_hits"]},
    "c_max": {"max": ["c_first", "c_names", "c_platform", "c_channel", "c_rendering", "c_current", "c_parts", "c_hits"]},
    "c_26b": {"file": "analysis/results/d2_26b/analyze_d2_26b.txt", "pattern": "^complete states \\(every arm x seeds 1-3 usable\\): (\\d+) of"},
    "c_e4b": {"file": "analysis/results/d2_e4b/analyze_d2_e4b.txt", "pattern": "^complete states \\(every arm x seeds 1-3 usable\\): (\\d+) of"},
    "c_qwen": {"file": "analysis/results/qwen/analyze_d2_qwen.txt", "pattern": "^complete states \\(every arm x seeds 1-3 usable\\): (\\d+) of"},

    "k_r": {"file": "analysis/results/k/analyze_k.txt", "pattern": "^complete states: R \\d+ of (\\d+),"},
    "k_u": {"file": "analysis/results/k/analyze_k.txt", "pattern": "^complete states: R \\d+ of \\d+, U \\d+ of (\\d+)"},
    "k_states_08": {"file": "analysis/results/g/analyze_g.txt", "pattern": "^  complete states: \\d+ of (\\d+) \\(R"},
    "k_states": {"sum": ["k_r", "k_u"], "equals": "k_states_08"},
    "k_r_seeds": {"file": "analysis/results/k/analyze_k.txt", "pattern": "^population R \\(\\d+ states x (\\d+) seeds per arm\\)"},
    "k_u_seeds": {"file": "analysis/results/k/analyze_k.txt", "pattern": "^population U \\(\\d+ states x (\\d+) seeds per arm\\)"},
    "k06_r": {"file": "analysis/results/k/analyze_k.txt", "pattern": "^complete states: R (\\d+) of"},
    "k06_u": {"file": "analysis/results/k/analyze_k.txt", "pattern": "^complete states: R \\d+ of \\d+, U (\\d+) of"},
    "k06": {"sum": ["k06_r", "k06_u"]},
    "k08": {"file": "analysis/results/g/analyze_g.txt", "pattern": "^  complete states: (\\d+) of \\d+ \\(R"},

    "f_built": {"file": "analysis/results/09/analyze_09.txt", "pattern": "^episodes in the file: (\\d+) of \\d+ expected"},
    "f_tasks": {"file": "analysis/results/09/analyze_09.txt", "pattern": "^  complete tasks: \\d+ of (\\d+)"},
    "f_seeds": {"file": "analysis/results/09/analyze_09.txt", "pattern": "^run: .*; seeds (\\[[^\\]]*\\])", "count": true},
    "f_conds": {"file": "analysis/results/09/analyze_09.txt", "pattern": "^run: .*; arms (\\[[^\\]]*\\])", "count": true},
    "f_product": {"product": ["f_tasks", "f_seeds", "f_conds"], "equals": "f_built"},
    "f_err_1": {"file": "analysis/results/09/analyze_09.txt", "pattern": "episodes that ended in an error, arm N: (\\d+)"},
    "f_err_2": {"file": "analysis/results/09/analyze_09.txt", "pattern": "episodes that ended in an error, arm NA: (\\d+)"},
    "f_err_3": {"file": "analysis/results/09/analyze_09.txt", "pattern": "episodes that ended in an error, arm NAF: (\\d+)"},
    "f_over_1": {"file": "analysis/results/09/analyze_09.txt", "pattern": "error, arm N: \\d+ \\{'context_overflow': (\\d+)\\}"},
    "f_over_2": {"file": "analysis/results/09/analyze_09.txt", "pattern": "error, arm NA: \\d+ \\{'context_overflow': (\\d+)\\}"},
    "f_over_3": {"file": "analysis/results/09/analyze_09.txt", "pattern": "error, arm NAF: \\d+ \\{'context_overflow': (\\d+)\\}"},
    "f_overflow": {"sum": ["f_over_1", "f_over_2", "f_over_3"]},
    "f_errors": {"sum": ["f_err_1", "f_err_2", "f_err_3"], "equals": "f_overflow"},
    "f_analyzed": {"minus": ["f_built", "f_errors"]},
    "f_complete": {"file": "analysis/results/09/analyze_09.txt", "pattern": "^  complete tasks: (\\d+) of"},
    "f_per_cond": {"file": "analysis/results/09/analyze_09.txt", "pattern": "^  Ynext N\\s*: [\\d.]+ \\[[\\d.]+, [\\d.]+\\] \\| \\d+/(\\d+)"},
    "f_gold": {"file": "analysis/results/09/analyze_09.txt", "pattern": "tasks whose gold patch modifies a file: (\\d+)"},
    "f_gold_eps": {"file": "analysis/results/09/analyze_09.txt", "pattern": "^\\s+Yline N\\s*: [\\d.]+ \\[[\\d.]+, [\\d.]+\\] \\| \\d+/(\\d+)"},

    "w_all": {"json": "analysis/results/14/validate/summary_validate.json", "field": "tasks"},
    "w_gold_ok": {"json": "analysis/results/14/validate/summary_validate.json", "field": "gold_resolved"},
    "w_empty": {"json": "analysis/results/14/validate/summary_validate.json", "field": "empty_resolved"},
    "w_ok": {"json": "analysis/results/14/validate/summary_validate.json", "field": "ok"},
    "w_gold_fail": {"minus": ["w_all", "w_gold_ok"]},
    "w_ok_check": {"minus": ["w_all", "w_gold_fail", "w_empty"], "equals": "w_ok"},
    "w_runs_1": {"file": "analysis/results/14/analyze_14.txt", "pattern": "^   N\\s+runs with a task result (\\d+)", "optional": true},
    "w_runs_2": {"file": "analysis/results/14/analyze_14.txt", "pattern": "^   NAF\\s+runs with a task result (\\d+)", "optional": true},
    "w_pairs": {"file": "analysis/results/14/analyze_14.txt", "pattern": "pairs with a task result in both conditions (\\d+)", "optional": true},
    "w_entered": {"file": "analysis/results/14/analyze_14.txt", "pattern": "ENTER the paired analysis (\\d+)", "optional": true},
    "w_gold": {"file": "analysis/results/14/analyze_14.txt", "pattern": "entered pairs with a GOLD FILE (\\d+)", "optional": true},
    "w_pairs_out": {"minus": ["w_pairs", "w_entered"]},

    "p_runs_1": {"file": "analysis/results/public/address.txt", "pattern": "starter agent \\(GraphLoc base arm, Sep\\), 31B\\s+(\\d+) traces"},
    "p_runs_2": {"file": "analysis/results/public/address.txt", "pattern": "custom agent 1 \\(Oct\\), 31B\\s+(\\d+) traces"},
    "p_runs_3": {"file": "analysis/results/public/address.txt", "pattern": "custom agent 2 \\(Oct to Nov\\), 31B\\s+(\\d+) traces"},
    "p_runs": {"sum": ["p_runs_1", "p_runs_2", "p_runs_3"]},
    "p_traj": {"file": "analysis/results/public/outside.txt", "pattern": "^A\\. .*\\n\\s+trajectories (\\d+),"},
    "p_traj_b": {"file": "analysis/results/public/outside.txt", "pattern": "^B\\. .*\\n\\s+trajectories (\\d+),", "equals": "p_traj"},
    "p_traj_c": {"file": "analysis/results/public/outside.txt", "pattern": "^C\\. .*\\n\\s+trajectories (\\d+),", "equals": "p_traj"},
    "p_traj_d": {"file": "analysis/results/public/outside.txt", "pattern": "^D\\. .*\\n\\s+trajectories (\\d+),", "equals": "p_traj"},
    "p_pairs_all": {"file": "analysis/results/public/time_to_fix.txt", "pattern": "pairs with both arms (\\d+);"},
    "p_pairs": {"file": "analysis/results/public/time_to_fix.txt", "pattern": "with a GOLD FILE (\\d+) \\("},
    "p_whole": {"file": "analysis/results/public/time_to_fix.txt", "pattern": "^   (\\d+) runs: shown a changed line"},
    "p_left": {"minus": ["p_pairs_all", "p_pairs"]}
  },
  "rows": [
    {"cells": ["One-step replays",
               "{states} paused steps ({runs} runs, {tasks} tasks), {seeds} seeds per condition",
               "{c_min} to {c_max} steps per experiment; {c_26b}, {c_e4b} and {c_qwen} with the three other models",
               "steps where a condition or seed returned no well-formed call"]},
    {"cells": ["Five-call replays",
               "{k_states} paused steps: {k_r} with a listed neighbor in a file the fix changes ({k_r_seeds} seeds), {k_u} without ({k_u_seeds} seeds)",
               "{k06} steps (pre-registration 06), {k08} (pre-registration 08)",
               "steps where a replay overflowed the context or began with a malformed call"]},
    {"cells": ["Fresh episodes",
               "{f_tasks} tasks × {f_seeds} seeds × {f_conds} conditions = {f_built} episodes",
               "{f_analyzed} episodes; rules that pair conditions: {f_complete} tasks ({f_per_cond} episodes per condition); outcomes on fix lines: {f_gold} tasks ({f_gold_eps})",
               "{f_errors} episodes that overflowed the context"]},
    {"cells": ["Whole runs scored by tests",
               "{w_ok} of {w_all} public tasks: the reference patch passes the tests in our sandbox and no patch does not; two conditions, seeds pending",
               "pending (pre-registration 14)",
               "{w_gold_fail} tasks that fail with the reference patch; {w_empty} that pass with no patch"],
     "cells_when": {"file": "analysis/results/14/analyze_14.txt",
                    "cells": ["Whole runs scored by tests",
                              "{w_ok} of {w_all} public tasks: the reference patch passes the tests in our sandbox and no patch does not; {w_runs_1} runs as shipped, {w_runs_2} addressed and repaired",
                              "{w_entered} pairs of a task and a seed; outcomes on fix lines: {w_gold} pairs",
                              "{w_gold_fail} tasks that fail with the reference patch; {w_empty} that pass with no patch; {w_pairs_out} pairs with a run that failed outside the agent"]}},
    {"cells": ["Public runs, recounted",
               "{p_runs} runs of Gemma-4-31B by three teams; {p_traj} trajectories each of Claude 3.7 Sonnet, GPT-4o, Qwen3-Coder-480B and Llama agents; {p_pairs_all} pairs of whole runs",
               "all first reads; {p_pairs} pairs of whole runs ({p_whole} runs)",
               "{p_left} pairs whose reference patch changes no existing file"]}
  ]
}
